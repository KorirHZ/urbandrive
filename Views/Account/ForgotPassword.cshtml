@{
    ViewData["Title"] = "Forgot Password - UrbanDrive";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Forgot Password</title>

    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            /* Color Variables */
            :root {
                --black: #1a1a1a;
                --gold: #DAA520;
                --gold-light: #FFD700;
                --white: #FFFFFF;
                --dark-gray: #666;
            }

            /* Navigation Bar */
            .navbar {
                background: var(--black);
                padding: 15px 50px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                border-bottom: 1px solid rgba(218, 165, 32, 0.3);
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1000;
            }

            .logo h1 {
                color: var(--gold);
                font-size: 24px;
            }

            .logo p {
                color: var(--white);
                font-size: 10px;
                letter-spacing: 2px;
            }

            .nav-links a {
                color: var(--white);
                text-decoration: none;
                margin-left: 30px;
                transition: color 0.3s;
            }

                .nav-links a:hover {
                    color: var(--gold);
                }

            /* Forgot Password Container */
            .forgot-container {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                padding: 100px 20px 40px;
            }

            .forgot-card {
                background: var(--white);
                border-radius: 20px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                max-width: 450px;
                width: 100%;
                overflow: hidden;
                animation: fadeInUp 0.5s ease;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .forgot-header {
                background: linear-gradient(135deg, var(--black) 0%, #2a2a2a 100%);
                padding: 30px;
                text-align: center;
                border-bottom: 3px solid var(--gold);
            }

                .forgot-header .icon {
                    font-size: 48px;
                    color: var(--gold);
                    margin-bottom: 10px;
                }

                .forgot-header h2 {
                    color: var(--gold);
                    font-size: 28px;
                    margin-bottom: 8px;
                }

                .forgot-header p {
                    color: #ccc;
                    font-size: 14px;
                }

            .forgot-body {
                padding: 30px;
            }

            .info-text {
                color: var(--dark-gray);
                font-size: 14px;
                text-align: center;
                margin-bottom: 25px;
                line-height: 1.6;
            }

                .info-text i {
                    color: var(--gold);
                    margin-right: 8px;
                }

            /* Form Styles */
            .form-group {
                margin-bottom: 25px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 8px;
                    font-weight: 600;
                    color: var(--black);
                }

                    .form-group label i {
                        color: var(--gold);
                        margin-right: 8px;
                    }

            .input-group {
                position: relative;
            }

                .input-group input {
                    width: 100%;
                    padding: 12px 15px;
                    border: 1px solid #ddd;
                    border-radius: 10px;
                    font-size: 15px;
                    transition: all 0.3s;
                }

                    .input-group input:focus {
                        outline: none;
                        border-color: var(--gold);
                        box-shadow: 0 0 0 3px rgba(218, 165, 32, 0.2);
                    }

            /* ==================== SPINNER ==================== */
            .spinner {
                width: 16px;
                height: 16px;
                border: 2px solid rgba(26, 26, 26, 0.3);
                border-top-color: #1a1a1a;
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
                display: inline-block;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* Button Loading State */
            .btn-loading {
                pointer-events: none;
                opacity: 0.8;
            }

                .btn-loading .btn-text,
                .btn-loading i {
                    visibility: hidden;
                }

                .btn-loading .spinner {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    margin-top: -8px;
                    margin-left: -8px;
                }

            /* Button */
            .btn-send {
                width: 100%;
                padding: 14px;
                background: var(--gold);
                color: var(--black);
                border: none;
                border-radius: 10px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                transition: all 0.3s;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

                .btn-send:hover {
                    background: var(--gold-light);
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(218, 165, 32, 0.3);
                }

                .btn-send:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                }

            /* Back to Login Link */
            .back-link {
                text-align: center;
                margin-top: 20px;
                padding-top: 20px;
                border-top: 1px solid #eee;
            }

                .back-link a {
                    color: var(--gold);
                    text-decoration: none;
                    font-weight: 500;
                }

                    .back-link a:hover {
                        text-decoration: underline;
                    }

            /* Alert Messages */
            .alert {
                padding: 12px 15px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-size: 14px;
            }

            .alert-success {
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
            }

            .alert-danger {
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
            }

            .alert-info {
                background: #d1ecf1;
                color: #0c5460;
                border: 1px solid #bee5eb;
            }

            /* Mobile Responsive */
            @@media (max-width: 768px) {
                .navbar {
                    padding: 15px 20px;
                }

                .logo h1 {
                    font-size: 20px;
                }

                .nav-links a {
                    margin-left: 20px;
                    font-size: 14px;
                }

                .forgot-header h2 {
                    font-size: 24px;
                }

                .forgot-body {
                    padding: 25px;
                }
            }

            @@media (max-width: 480px) {
                .navbar {
                    flex-direction: column;
                    gap: 10px;
                }

                .nav-links a {
                    margin: 0 10px;
                }

                .forgot-card {
                    margin: 0 15px;
                }

                .forgot-header .icon {
                    font-size: 36px;
                }
            }
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <div class="navbar">
        <div class="logo">
            <a href="/" style="text-decoration: none;">
                <h1>URBANDRIVE</h1>
                <p>EXECUTIVE</p>
            </a>
        </div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Account/Login">Login</a>
        </div>
    </div>

    <!-- Forgot Password Container -->
    <div class="forgot-container">
        <div class="forgot-card">
            <div class="forgot-header">
                <div class="icon"><i class="fas fa-key"></i></div>
                <h2>Forgot Password</h2>
                <p>Enter your email to reset your password</p>
            </div>
            <div class="forgot-body">

                <!-- Alert Messages -->
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> @TempData["Message"]
                    </div>
                }

                <div id="alertMessage" style="display: none;" class="alert"></div>

                <div class="info-text">
                    <i class="fas fa-envelope"></i>
                    We'll send a password reset link to your email address
                </div>

                <!-- Forgot Password Form -->
                <form id="forgotForm" action="/Account/ForgotPassword" method="post">
                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email Address</label>
                        <div class="input-group">
                            <input type="email" id="email" name="email" placeholder="Enter your registered email" required>
                        </div>
                    </div>

                    <button type="submit" class="btn-send" id="sendBtn">
                        <i class="fas fa-paper-plane"></i>
                        <span class="btn-text">Send Reset Link</span>
                        <span class="spinner" style="display: none;"></span>
                    </button>

                    <div class="back-link">
                        <a href="/Account/Login"><i class="fas fa-arrow-left"></i> Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
            // ==================== LOADING ANIMATION ====================
            document.getElementById('forgotForm').addEventListener('submit', function() {
                var sendBtn = document.getElementById('sendBtn');
                var spinner = sendBtn.querySelector('.spinner');
                var btnText = sendBtn.querySelector('.btn-text');
                var btnIcon = sendBtn.querySelector('i');

                // Disable button
                sendBtn.disabled = true;
                sendBtn.classList.add('btn-loading');

                // Hide text and icon
                if (btnText) btnText.style.visibility = 'hidden';
                if (btnIcon) btnIcon.style.visibility = 'hidden';

                // Show spinner
                if (spinner) spinner.style.display = 'inline-block';
            });

            function showAlert(message, type) {
                var alertDiv = document.getElementById('alertMessage');
                alertDiv.className = 'alert alert-' + type;
                alertDiv.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + '"></i> ' + message;
                alertDiv.style.display = 'block';

                setTimeout(function() {
                    alertDiv.style.display = 'none';
                }, 5000);
            }

            // Display any TempData messages on page load
            window.onload = function() {
                var urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('error') === 'true') {
                    showAlert('Please enter a valid email address.', 'danger');
                }
            }
    </script>
</body>
</html>