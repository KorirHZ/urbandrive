@{
    ViewData["Title"] = "Login - UrbanDrive";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Login</title>

    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
                min-height: 100vh;
            }

            /* Color Variables */
            :root {
                --black: #1a1a1a;
                --gold: #DAA520;
                --gold-light: #FFD700;
                --white: #FFFFFF;
                --dark-gray: #666;
            }

            /* Navigation Bar */
            .navbar {
                background: var(--black);
                padding: 15px 50px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                border-bottom: 1px solid rgba(218, 165, 32, 0.3);
            }

            .logo h1 {
                color: var(--gold);
                font-size: 24px;
            }

            .logo p {
                color: var(--white);
                font-size: 10px;
                letter-spacing: 2px;
            }

            .nav-links a {
                color: var(--white);
                text-decoration: none;
                margin-left: 30px;
                transition: color 0.3s;
            }

                .nav-links a:hover {
                    color: var(--gold);
                }

            /* Login Container */
            .login-container {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: calc(100vh - 80px);
                padding: 40px 20px;
            }

            .login-card {
                background: var(--white);
                border-radius: 20px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                max-width: 450px;
                width: 100%;
                overflow: hidden;
                animation: fadeInUp 0.5s ease;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .login-header {
                background: linear-gradient(135deg, var(--black) 0%, #2a2a2a 100%);
                padding: 30px;
                text-align: center;
                border-bottom: 3px solid var(--gold);
            }

                .login-header h2 {
                    color: var(--gold);
                    font-size: 28px;
                    margin-bottom: 8px;
                }

                .login-header p {
                    color: #ccc;
                    font-size: 14px;
                }

            .login-body {
                padding: 30px;
            }

            /* Form Styles */
            .form-group {
                margin-bottom: 25px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 8px;
                    font-weight: 600;
                    color: var(--black);
                }

                    .form-group label i {
                        color: var(--gold);
                        margin-right: 8px;
                    }

            .input-group {
                position: relative;
            }

                .input-group input {
                    width: 100%;
                    padding: 12px 15px;
                    border: 1px solid #ddd;
                    border-radius: 10px;
                    font-size: 15px;
                    transition: all 0.3s;
                }

                    .input-group input:focus {
                        outline: none;
                        border-color: var(--gold);
                        box-shadow: 0 0 0 3px rgba(218, 165, 32, 0.2);
                    }

                .input-group .toggle-password {
                    position: absolute;
                    right: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    cursor: pointer;
                    color: var(--dark-gray);
                }

            /* Remember Me & Forgot Password */
            .options {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            .checkbox {
                display: flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
            }

                .checkbox input {
                    width: 16px;
                    height: 16px;
                    cursor: pointer;
                }

                .checkbox span {
                    font-size: 14px;
                    color: var(--dark-gray);
                }

            .forgot-link {
                color: var(--gold);
                text-decoration: none;
                font-size: 14px;
            }

                .forgot-link:hover {
                    text-decoration: underline;
                }

            /* Button */
            .btn-login {
                width: 100%;
                padding: 14px;
                background: var(--gold);
                color: var(--black);
                border: none;
                border-radius: 10px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                transition: all 0.3s;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

                .btn-login:hover {
                    background: var(--gold-light);
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(218, 165, 32, 0.3);
                }

            /* Loader Animation */
            .loader {
                font-size: 10px;
                width: 1em;
                height: 1em;
                border-radius: 50%;
                position: relative;
                text-indent: -9999em;
                animation: mulShdSpin 1.1s infinite ease;
                transform: translateZ(0);
                display: inline-block;
            }

            @@keyframes mulShdSpin {
                0%, 100% {
                    box-shadow: 0em -2.6em 0em 0em #1a1a1a, 1.8em -1.8em 0 0em rgba(26,26,26, 0.2), 2.5em 0em 0 0em rgba(26,26,26, 0.2), 1.75em 1.75em 0 0em rgba(26,26,26, 0.2), 0em 2.5em 0 0em rgba(26,26,26, 0.2), -1.8em 1.8em 0 0em rgba(26,26,26, 0.2), -2.6em 0em 0 0em rgba(26,26,26, 0.5), -1.8em -1.8em 0 0em rgba(26,26,26, 0.7);
                }

                12.5% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.7), 1.8em -1.8em 0 0em #1a1a1a, 2.5em 0em 0 0em rgba(26,26,26, 0.2), 1.75em 1.75em 0 0em rgba(26,26,26, 0.2), 0em 2.5em 0 0em rgba(26,26,26, 0.2), -1.8em 1.8em 0 0em rgba(26,26,26, 0.2), -2.6em 0em 0 0em rgba(26,26,26, 0.2), -1.8em -1.8em 0 0em rgba(26,26,26, 0.5);
                }

                25% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.5), 1.8em -1.8em 0 0em rgba(26,26,26, 0.7), 2.5em 0em 0 0em #1a1a1a, 1.75em 1.75em 0 0em rgba(26,26,26, 0.2), 0em 2.5em 0 0em rgba(26,26,26, 0.2), -1.8em 1.8em 0 0em rgba(26,26,26, 0.2), -2.6em 0em 0 0em rgba(26,26,26, 0.2), -1.8em -1.8em 0 0em rgba(26,26,26, 0.2);
                }

                37.5% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.2), 1.8em -1.8em 0 0em rgba(26,26,26, 0.5), 2.5em 0em 0 0em rgba(26,26,26, 0.7), 1.75em 1.75em 0 0em #1a1a1a, 0em 2.5em 0 0em rgba(26,26,26, 0.2), -1.8em 1.8em 0 0em rgba(26,26,26, 0.2), -2.6em 0em 0 0em rgba(26,26,26, 0.2), -1.8em -1.8em 0 0em rgba(26,26,26, 0.2);
                }

                50% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.2), 1.8em -1.8em 0 0em rgba(26,26,26, 0.2), 2.5em 0em 0 0em rgba(26,26,26, 0.5), 1.75em 1.75em 0 0em rgba(26,26,26, 0.7), 0em 2.5em 0 0em #1a1a1a, -1.8em 1.8em 0 0em rgba(26,26,26, 0.2), -2.6em 0em 0 0em rgba(26,26,26, 0.2), -1.8em -1.8em 0 0em rgba(26,26,26, 0.2);
                }

                62.5% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.2), 1.8em -1.8em 0 0em rgba(26,26,26, 0.2), 2.5em 0em 0 0em rgba(26,26,26, 0.2), 1.75em 1.75em 0 0em rgba(26,26,26, 0.5), 0em 2.5em 0 0em rgba(26,26,26, 0.7), -1.8em 1.8em 0 0em #1a1a1a, -2.6em 0em 0 0em rgba(26,26,26, 0.2), -1.8em -1.8em 0 0em rgba(26,26,26, 0.2);
                }

                75% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.2), 1.8em -1.8em 0 0em rgba(26,26,26, 0.2), 2.5em 0em 0 0em rgba(26,26,26, 0.2), 1.75em 1.75em 0 0em rgba(26,26,26, 0.2), 0em 2.5em 0 0em rgba(26,26,26, 0.5), -1.8em 1.8em 0 0em rgba(26,26,26, 0.7), -2.6em 0em 0 0em #1a1a1a, -1.8em -1.8em 0 0em rgba(26,26,26, 0.2);
                }

                87.5% {
                    box-shadow: 0em -2.6em 0em 0em rgba(26,26,26, 0.2), 1.8em -1.8em 0 0em rgba(26,26,26, 0.2), 2.5em 0em 0 0em rgba(26,26,26, 0.2), 1.75em 1.75em 0 0em rgba(26,26,26, 0.2), 0em 2.5em 0 0em rgba(26,26,26, 0.2), -1.8em 1.8em 0 0em rgba(26,26,26, 0.5), -2.6em 0em 0 0em rgba(26,26,26, 0.7), -1.8em -1.8em 0 0em #1a1a1a;
                }
            }

            /* Button Loading State */
            .btn-loading {
                pointer-events: none;
                opacity: 0.8;
            }

                .btn-loading .btn-text,
                .btn-loading i {
                    visibility: hidden;
                }

                .btn-loading .loader {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    margin-top: -5px;
                    margin-left: -5px;
                    visibility: visible;
                }

            /* Register Link */
            .register-link {
                text-align: center;
                margin-top: 25px;
                padding-top: 20px;
                border-top: 1px solid #eee;
            }

                .register-link p {
                    color: var(--dark-gray);
                }

                .register-link a {
                    color: var(--gold);
                    text-decoration: none;
                    font-weight: bold;
                }

                    .register-link a:hover {
                        text-decoration: underline;
                    }

            /* Demo Credentials */
            .demo-credentials {
                margin-top: 20px;
                padding: 15px;
                background: #f8f9fa;
                border-radius: 10px;
                text-align: center;
            }

                .demo-credentials p {
                    font-size: 12px;
                    color: var(--dark-gray);
                    margin-bottom: 8px;
                }

                .demo-credentials .cred {
                    font-family: monospace;
                    font-size: 12px;
                    color: var(--gold);
                }

            /* Alert Messages */
            .alert {
                padding: 12px 15px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-size: 14px;
            }

            .alert-success {
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
            }

            .alert-danger {
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
            }

            /* Mobile Responsive */
            @@media (max-width: 768px) {
                .navbar {
                    padding: 15px 20px;
                }

                .logo h1 {
                    font-size: 20px;
                }

                .nav-links a {
                    margin-left: 20px;
                    font-size: 14px;
                }

                .login-header h2 {
                    font-size: 24px;
                }

                .login-body {
                    padding: 25px;
                }
            }

            @@media (max-width: 480px) {
                .navbar {
                    flex-direction: column;
                    gap: 10px;
                }

                .nav-links a {
                    margin: 0 10px;
                }

                .login-card {
                    margin: 0 15px;
                }
            }
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <div class="navbar">
        <div class="logo">
            <a href="/" style="text-decoration: none;">
                <h1>URBANDRIVE</h1>
                <p>EXECUTIVE</p>
            </a>
        </div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Account/Register">Register</a>
        </div>
    </div>

    <!-- Login Container -->
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h2>Welcome Back</h2>
                <p>Login to your UrbanDrive account</p>
            </div>
            <div class="login-body">

                <!-- Alert Messages -->
                <div id="alertMessage" style="display: none;" class="alert"></div>

                <!-- Login Form -->
                <form id="loginForm" action="/Account/Login" method="post">
                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email Address</label>
                        <div class="input-group">
                            <input type="email" id="email" name="email" placeholder="Enter your email" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-lock"></i> Password</label>
                        <div class="input-group">
                            <input type="password" id="password" name="password" placeholder="Enter your password" required>
                            <i class="fas fa-eye toggle-password" onclick="togglePassword()"></i>
                        </div>
                    </div>

                    <div class="options">
                        <label class="checkbox">
                            <input type="checkbox" name="rememberMe">
                            <span>Remember me</span>
                        </label>
                        <a href="/Account/ForgotPassword" class="forgot-link">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn-login" id="loginBtn">
                        <i class="fas fa-sign-in-alt"></i>
                        <span class="btn-text">Login</span>
                        <span class="loader" style="display: none;"></span>
                    </button>

                    <div class="register-link">
                        <p>Don't have an account? <a href="/Account/Register">Create an account</a></p>
                    </div>

                    <!-- Demo Credentials (for testing only - remove in production) -->
                    <div class="demo-credentials">
                        <p><i class="fas fa-info-circle"></i> Demo Credentials:</p>
                        <p class="cred">User: user@urbandrive.com / password123</p>
                        <p class="cred">Admin: admin@urbandrive.com / Admin@123</p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
            // Password Toggle Function
            function togglePassword() {
                var passwordField = document.getElementById('password');
                var icon = document.querySelector('.toggle-password');

                if (passwordField.type === "password") {
                    passwordField.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    passwordField.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            }

            // Login Form Loading Animation
            document.getElementById('loginForm').addEventListener('submit', function(e) {
                var loginBtn = document.getElementById('loginBtn');
                var loader = loginBtn.querySelector('.loader');
                var btnText = loginBtn.querySelector('.btn-text');
                var btnIcon = loginBtn.querySelector('i');

                // Add loading class
                loginBtn.classList.add('btn-loading');
                loginBtn.disabled = true;

                // Hide text and icon
                if (btnText) btnText.style.visibility = 'hidden';
                if (btnIcon) btnIcon.style.visibility = 'hidden';

                // Show loader
                if (loader) loader.style.display = 'inline-block';
            });

            function showAlert(message, type) {
                var alertDiv = document.getElementById('alertMessage');
                alertDiv.className = 'alert alert-' + type;
                alertDiv.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + '"></i> ' + message;
                alertDiv.style.display = 'block';

                setTimeout(function() {
                    alertDiv.style.display = 'none';
                }, 5000);
            }

            // Check for success message from registration
            window.onload = function() {
                var urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('registered') === 'success') {
                    showAlert('Registration successful! Please login with your credentials.', 'success');
                }
            }
    </script>
</body>
</html>