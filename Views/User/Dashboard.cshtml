@{
    ViewData["Title"] = "User Dashboard - UrbanDrive";
    Layout = null;
}

@model UrbanDrive.Models.UserDashboardViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - User Dashboard</title>

    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;
        }

        /* Color Variables */
        :root {
            --black: #1a1a1a;
            --gold: #DAA520;
            --gold-light: #FFD700;
            --white: #FFFFFF;
            --dark-gray: #666;
            --pending: #f39c12;
            --approved: #27ae60;
            --completed: #3498db;
            --cancelled: #e74c3c;
        }

        /* Navigation Bar */
        .navbar {
            background: var(--black);
            padding: 15px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }

        .logo h1 {
            color: var(--gold);
            font-size: 24px;
        }

        .logo p {
            color: var(--white);
            font-size: 10px;
            letter-spacing: 2px;
        }

        .nav-links a {
            color: var(--white);
            text-decoration: none;
            margin-left: 30px;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--gold);
        }

        .user-info {
            display: inline-block;
            margin-left: 30px;
            color: var(--gold);
        }

        /* Main Container */
        .dashboard-container {
            margin-top: 80px;
            padding: 30px 50px;
        }

        /* Welcome Section */
        .welcome-section {
            background: linear-gradient(135deg, var(--black) 0%, #2a2a2a 100%);
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            color: var(--white);
        }

        .welcome-section h2 {
            font-size: 28px;
            margin-bottom: 10px;
        }

        .welcome-section h2 i {
            color: var(--gold);
            margin-right: 10px;
        }

        .welcome-section p {
            color: #ccc;
        }

        /* Stats Cards */
        .stats-grid {
            display: flex;
            gap: 25px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1;
            min-width: 200px;
            background: var(--white);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            text-align: center;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card i {
            font-size: 40px;
            color: var(--gold);
            margin-bottom: 15px;
        }

        .stat-card h3 {
            font-size: 32px;
            color: var(--black);
            margin-bottom: 5px;
        }

        .stat-card p {
            color: var(--dark-gray);
            font-size: 14px;
        }

        /* Section Titles */
        .section-title {
            font-size: 24px;
            color: var(--black);
            margin-bottom: 20px;
            border-left: 4px solid var(--gold);
            padding-left: 15px;
        }

        /* Booking Form Card */
        .form-card {
            background: var(--white);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 40px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .form-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .form-group {
            flex: 1;
            min-width: 200px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--black);
        }

        .form-group label i {
            color: var(--gold);
            margin-right: 8px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(218, 165, 32, 0.2);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }

        .btn-submit {
            background: var(--gold);
            color: var(--black);
            border: none;
            padding: 14px 30px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            width: 100%;
        }

        .btn-submit:hover {
            background: var(--gold-light);
            transform: translateY(-2px);
        }

        /* Bookings Table */
        .table-container {
            background: var(--white);
            border-radius: 15px;
            overflow-x: auto;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .bookings-table {
            width: 100%;
            border-collapse: collapse;
        }

        .bookings-table th {
            background: var(--black);
            color: var(--white);
            padding: 15px;
            text-align: left;
        }

        .bookings-table td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

        .bookings-table tr:hover {
            background: #f9f9f9;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-pending { background: var(--pending); color: white; }
        .status-approved { background: var(--approved); color: white; }
        .status-completed { background: var(--completed); color: white; }
        .status-cancelled { background: var(--cancelled); color: white; }
        .status-rejected { background: var(--cancelled); color: white; }

        .btn-view {
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            padding: 5px 12px;
            border-radius: 5px;
            cursor: pointer;
            margin-right: 5px;
        }

        .btn-cancel {
            background: transparent;
            border: 1px solid var(--cancelled);
            color: var(--cancelled);
            padding: 5px 12px;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn-view:hover {
            background: var(--gold);
            color: var(--black);
        }

        .btn-cancel:hover {
            background: var(--cancelled);
            color: white;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            background: var(--white);
            border-radius: 15px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            animation: slideIn 0.3s ease;
        }

        @@keyframes slideIn {
            from { opacity: 0; transform: translateY(-50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .modal-header {
            background: var(--black);
            color: var(--white);
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h3 {
            color: var(--gold);
        }

        .modal-header .close-modal {
            background: none;
            border: none;
            color: white;
            font-size: 24px;
            cursor: pointer;
        }

        .modal-body {
            padding: 20px;
        }

        .detail-row {
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .detail-row strong {
            color: var(--gold);
            display: inline-block;
            width: 140px;
        }

        .driver-info {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin-top: 15px;
        }

        /* Alert Messages */
        .alert {
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            display: none;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        /* Loading Spinner */
        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid var(--black);
            border-top-color: var(--gold);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* Mobile Responsive */
        @@media (max-width: 992px) {
            .dashboard-container { padding: 20px; }
        }

        @@media (max-width: 768px) {
            .navbar { padding: 15px 20px; }
            .nav-links a { margin-left: 15px; font-size: 14px; }
            .stats-grid { flex-direction: column; }
            .form-row { flex-direction: column; }
            .bookings-table { font-size: 12px; }
            .bookings-table th, .bookings-table td { padding: 10px; }
        }
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <div class="navbar">
        <div class="logo">
            <a href="/" style="text-decoration: none;">
                <h1>URBANDRIVE</h1>
                <p>EXECUTIVE</p>
            </a>
        </div>
        <div class="nav-links">
            <a href="/"><i class="fas fa-home"></i> Home</a>
            <a href="/User/Dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
            <span class="user-info"><i class="fas fa-user-circle"></i> @User.Identity.Name</span>
        </div>
    </div>

    <!-- Main Dashboard -->
    <div class="dashboard-container">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <h2><i class="fas fa-car"></i> Welcome back, @User.Identity.Name!</h2>
            <p>Manage your vehicle bookings, track requests, and view trip details all in one place.</p>
        </div>

        <!-- Alert Messages -->
        <div id="alertMessage" class="alert"></div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-calendar-alt"></i>
                <h3 id="totalBookings">@Model.TotalBookings</h3>
                <p>Total Bookings</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-clock"></i>
                <h3 id="pendingBookings">@Model.PendingBookings</h3>
                <p>Pending Approval</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-check-circle"></i>
                <h3 id="completedBookings">@Model.CompletedBookings</h3>
                <p>Completed Trips</p>
            </div>
        </div>

        <!-- Quick Booking Form -->
        <div class="form-card">
            <h3 class="section-title"><i class="fas fa-plus-circle"></i> Book a Vehicle</h3>
            <form id="bookingForm">
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-map-marker-alt"></i> Destination *</label>
                        <input type="text" id="destination" name="Destination" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-location-dot"></i> Pickup Location</label>
                        <input type="text" id="pickupLocation" name="PickupLocation">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-calendar"></i> Pickup Date *</label>
                        <input type="date" id="startDate" name="StartDate" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-clock"></i> Pickup Time *</label>
                        <input type="time" id="startTime" name="StartTime" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-calendar-alt"></i> Return Date</label>
                        <input type="date" id="endDate" name="EndDate">
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-users"></i> Passengers *</label>
                        <input type="number" id="passengers" name="NumberOfPassengers" value="1" min="1" max="20" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-info-circle"></i> Purpose of Travel *</label>
                        <textarea id="purpose" name="Purpose" required></textarea>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-comment"></i> Special Requests</label>
                        <textarea id="specialRequests" name="SpecialRequests"></textarea>
                    </div>
                </div>
                <button type="submit" class="btn-submit" id="submitBtn">
                    <i class="fas fa-paper-plane"></i> Submit Booking Request
                </button>
            </form>
        </div>

        <!-- My Bookings Table -->
        <h3 class="section-title"><i class="fas fa-list"></i> My Bookings</h3>
        <div class="table-container">
            <table class="bookings-table">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Destination</th>
                        <th>Pickup Date</th>
                        <th>Purpose</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="bookingsTableBody">
                    @foreach (var booking in Model.RecentBookings)
                    {
                        <tr>
                            <td>@booking.BookingId</td>
                            <td>@booking.Destination</td>
                            <td>@booking.StartDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</td>
                            <td>@(booking.Purpose.Length > 30 ? booking.Purpose.Substring(0, 30) + "..." : booking.Purpose)</td>
                            <td>
                                @if (booking.Status == "Pending")
                                {
                                    <span class="status-badge status-pending"><i class="fas fa-clock"></i> Pending</span>
                                }
                                else if (booking.Status == "Approved")
                                {
                                    <span class="status-badge status-approved"><i class="fas fa-check-circle"></i> Approved</span>
                                }
                                else if (booking.Status == "Completed")
                                {
                                    <span class="status-badge status-completed"><i class="fas fa-check-double"></i> Completed</span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="status-badge status-cancelled"><i class="fas fa-ban"></i> Cancelled</span>
                                }
                                else if (booking.Status == "Rejected")
                                {
                                    <span class="status-badge status-cancelled"><i class="fas fa-times-circle"></i> Rejected</span>
                                }
                            </td>
                            <td>
                                <button class="btn-view" onclick="viewBooking(@booking.BookingId)">
                                    <i class="fas fa-eye"></i> View
                                </button>
                                @if (booking.Status == "Pending")
                                {
                                    <button class="btn-cancel" onclick="cancelBooking(@booking.BookingId)">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.RecentBookings.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align: center;">No bookings found. Book your first vehicle above!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div> 
    </div>

    <!-- Booking Details Modal -->
    <div id="detailsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-info-circle"></i> Booking Details</h3>
                <button class="close-modal" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Content loaded dynamically -->
            </div>
        </div>
    </div>

    <script>
            // Set min date to today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('startDate').min = today;
            if (document.getElementById('endDate')) {
                document.getElementById('endDate').min = today;
            }

            // Show alert function
            function showAlert(message, type) {
                const alertDiv = document.getElementById('alertMessage');
                alertDiv.className = 'alert alert-' + type;
                alertDiv.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + '"></i> ' + message;
                alertDiv.style.display = 'block';
                setTimeout(() => {
                    alertDiv.style.display = 'none';
                }, 5000);
            }

            // Update stats on page
            function updateStats(newTotal, newPending, newCompleted) {
                document.getElementById('totalBookings').innerText = newTotal;
                document.getElementById('pendingBookings').innerText = newPending;
                document.getElementById('completedBookings').innerText = newCompleted;
            }

            // Add new booking to table (FIXED)
            function addBookingToTable(booking) {
                const tbody = document.getElementById('bookingsTableBody');

                // Remove "no bookings" row if exists
                if (tbody.children.length === 1 && tbody.children[0].innerText.includes('No bookings')) {
                    tbody.innerHTML = '';
                }

                const statusHtml = booking.status === 'Pending'
                    ? '<span class="status-badge status-pending"><i class="fas fa-clock"></i> Pending</span>'
                    : '<span class="status-badge">' + booking.status + '</span>';

                const actionHtml = booking.status === 'Pending'
                    ? '<button class="btn-view" onclick="viewBooking(' + booking.bookingId + ')"><i class="fas fa-eye"></i> View</button> <button class="btn-cancel" onclick="cancelBooking(' + booking.bookingId + ')"><i class="fas fa-times"></i> Cancel</button>'
                    : '<button class="btn-view" onclick="viewBooking(' + booking.bookingId + ')"><i class="fas fa-eye"></i> View</button>';

                // Create new row with proper table cells (FIXED: proper closing tags)
                const newRow = document.createElement('tr');
                newRow.innerHTML = `
                    <td>${booking.bookingId}</td>
                    <td>${booking.destination}</td>
                    <td>${booking.startDate}</td>
                    <td>${booking.purpose.length > 30 ? booking.purpose.substring(0, 30) + '...' : booking.purpose}</td>
                    <td>${statusHtml}</td>
                    <td>${actionHtml}</td>
                `;

                // Add to top of table
                tbody.insertBefore(newRow, tbody.firstChild);
            }

            // Handle booking form submission
            document.getElementById('bookingForm').addEventListener('submit', async function(e) {
                e.preventDefault();

                const submitBtn = document.getElementById('submitBtn');
                const originalText = submitBtn.innerHTML;

                const destination = document.getElementById('destination').value;
                const startDate = document.getElementById('startDate').value;
                const startTime = document.getElementById('startTime').value;
                const purpose = document.getElementById('purpose').value;

                if (!destination || !startDate || !startTime || !purpose) {
                    showAlert('Please fill all required fields!', 'danger');
                    return;
                }

                // Create proper DateTime format
                const startDateTime = new Date(startDate + 'T' + startTime + ':00');
                if (isNaN(startDateTime.getTime())) {
                    showAlert('Invalid date format', 'danger');
                    return;
                }

                const formData = {
                    Destination: destination,
                    PickupLocation: document.getElementById('pickupLocation').value || null,
                    StartDate: startDateTime.toISOString(),
                    EndDate: document.getElementById('endDate').value ? new Date(document.getElementById('endDate').value + 'T23:59:00').toISOString() : null,
                    NumberOfPassengers: parseInt(document.getElementById('passengers').value),
                    Purpose: purpose,
                    SpecialRequests: document.getElementById('specialRequests').value || null
                };

                submitBtn.innerHTML = '<span class="spinner"></span> Submitting...';
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/User/CreateBookingAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const result = await response.json();

                    if (result.success) {
                        updateStats(result.newTotal, result.newPending, result.newCompleted);
                        addBookingToTable(result.booking);
                        document.getElementById('bookingForm').reset();
                        document.getElementById('startDate').min = today;
                        showAlert('Booking request submitted successfully! You will be notified once approved.', 'success');
                    } else {
                        showAlert(result.message || 'Failed to submit booking. Please try again.', 'danger');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showAlert('An error occurred. Please try again.', 'danger');
                } finally {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            });

            // View booking details
            async function viewBooking(bookingId) {
                try {
                    const response = await fetch(`/User/GetBookingDetails?bookingId=${bookingId}`);
                    const data = await response.json();

                    if (data.success) {
                        let modalContent = `
                            <div class="detail-row"><strong>Booking ID:</strong> ${data.booking.bookingId}</div>
                            <div class="detail-row"><strong>Destination:</strong> ${data.booking.destination}</div>
                            <div class="detail-row"><strong>Pickup Date:</strong> ${data.booking.startDate}</div>
                            <div class="detail-row"><strong>Purpose:</strong> ${data.booking.purpose}</div>
                            <div class="detail-row"><strong>Passengers:</strong> ${data.booking.numberOfPassengers}</div>
                            <div class="detail-row"><strong>Status:</strong> ${data.booking.status}</div>
                        `;
                        if (data.booking.driverName) {
                            modalContent += `
                                <div class="driver-info">
                                    <h4><i class="fas fa-user-check"></i> Driver Details</h4>
                                    <div class="detail-row"><strong>Driver Name:</strong> ${data.booking.driverName}</div>
                                    <div class="detail-row"><strong>Driver Phone:</strong> ${data.booking.driverPhone || 'Pending'}</div>
                                    <div class="detail-row"><strong>Vehicle:</strong> ${data.booking.vehicleModel || 'N/A'} (${data.booking.vehicleReg || 'N/A'})</div>
                                </div>
                            `;
                        }
                        document.getElementById('modalBody').innerHTML = modalContent;
                        document.getElementById('detailsModal').classList.add('show');
                    } else {
                        showAlert('Failed to load booking details.', 'danger');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showAlert('An error occurred.', 'danger');
                }
            }

            // Cancel booking
            async function cancelBooking(bookingId) {
                if (confirm('Are you sure you want to cancel this booking?')) {
                    try {
                        const response = await fetch(`/User/CancelBookingAjax?bookingId=${bookingId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const result = await response.json();
                        if (result.success) {
                            location.reload();
                        } else {
                            showAlert(result.message || 'Failed to cancel booking.', 'danger');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showAlert('An error occurred.', 'danger');
                    }
                }
            }

            // Close modal
            function closeModal() {
                document.getElementById('detailsModal').classList.remove('show');
            }

            // Close modal on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeModal();
                }
            });
