@{
    ViewData["Title"] = "User Management - UrbanDrive";
    Layout = null;
}

@model List<UrbanDrive.Models.User>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Registered Users</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f0eb;
                display: flex;
                min-height: 100vh;
                overflow-x: hidden;
            }

            :root {
                --sidebar-width: 250px;
                --gold: #DAA520;
                --dark: #1a1a2e;
                --cream: #f5f0eb;
                --white: #ffffff;
                --success: #27ae60;
                --danger: #e74c3c;
            }

            /* ==================== SIDEBAR ==================== */
            .sidebar {
                width: var(--sidebar-width);
                background: var(--dark);
                color: white;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                display: flex;
                flex-direction: column;
                transition: left 0.3s ease;
                z-index: 1000;
                overflow-x: hidden;
            }

            .sidebar-brand {
                padding: 20px;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

                .sidebar-brand h1 {
                    color: var(--gold);
                    font-size: 22px;
                    letter-spacing: 2px;
                }

                .sidebar-brand p {
                    color: rgba(255,255,255,0.5);
                    font-size: 10px;
                    letter-spacing: 3px;
                }

            .sidebar-divider {
                height: 1px;
                background: rgba(255,255,255,0.05);
                margin: 10px 20px;
            }

            .sidebar-nav {
                flex: 1;
                padding: 10px 0;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 12px 25px;
                color: rgba(255,255,255,0.7);
                text-decoration: none;
                transition: all 0.3s;
                font-size: 14px;
                border-left: 3px solid transparent;
            }

                .sidebar-link:hover {
                    background: rgba(255,255,255,0.05);
                    color: white;
                }

                .sidebar-link.active {
                    background: rgba(218, 165, 32, 0.1);
                    color: var(--gold);
                    border-left-color: var(--gold);
                }

                .sidebar-link i {
                    width: 20px;
                    font-size: 16px;
                }

            .sidebar-footer {
                padding: 15px 20px;
                border-top: 1px solid rgba(255,255,255,0.05);
            }

            .sidebar-user {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,0.7);
                font-size: 14px;
                margin-top: 10px;
            }

                .sidebar-user i {
                    font-size: 28px;
                    color: var(--gold);
                }

            /* Mobile Toggle */
            .sidebar-toggle {
                display: none;
                position: fixed;
                top: 15px;
                left: 15px;
                z-index: 1100;
                background: var(--dark);
                color: var(--gold);
                border: none;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 20px;
                cursor: pointer;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
            }

                .sidebar-overlay.show {
                    display: block;
                }

            /* ==================== MAIN CONTENT ==================== */
            .main-content {
                margin-left: var(--sidebar-width);
                flex: 1;
                padding: 25px 30px;
                transition: margin-left 0.3s ease;
                min-height: 100vh;
            }

            .page-header {
                margin-bottom: 25px;
            }

                .page-header h2 {
                    font-size: 28px;
                    color: var(--dark);
                    border-left: 4px solid var(--gold);
                    padding-left: 15px;
                }

                .page-header p {
                    color: #666;
                    font-size: 14px;
                    margin-top: 5px;
                    padding-left: 19px;
                }

            /* ==================== STATS CARDS ==================== */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
                margin-bottom: 30px;
            }

            .stat-card {
                border-radius: 15px;
                padding: 22px 25px;
                color: white;
                position: relative;
                overflow: hidden;
                transition: transform 0.3s;
                cursor: default;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            }

                .stat-card:hover {
                    transform: translateY(-5px);
                }

                .stat-card .stat-icon {
                    position: absolute;
                    right: 15px;
                    top: 15px;
                    font-size: 40px;
                    opacity: 0.2;
                }

                .stat-card .stat-label {
                    font-size: 13px;
                    opacity: 0.8;
                    margin-bottom: 5px;
                    font-weight: 500;
                }

                .stat-card .stat-number {
                    font-size: 32px;
                    font-weight: bold;
                }

                .stat-card .stat-change {
                    font-size: 12px;
                    margin-top: 8px;
                    opacity: 0.9;
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }

            .stat-change.positive {
                color: #a8e6cf;
            }

            .stat-change.negative {
                color: #ff6b6b;
            }

            /* Card Gradients */
            .card-blue {
                background: linear-gradient(135deg, #2193b0, #6dd5ed);
            }

            .card-green {
                background: linear-gradient(135deg, #11998e, #38ef7d);
            }

            .card-orange {
                background: linear-gradient(135deg, #f12711, #f5af19);
            }

            .card-purple {
                background: linear-gradient(135deg, #8E2DE2, #4A00E0);
            }

            /* ==================== TABLE ==================== */
            .table-container {
                background: var(--white);
                border-radius: 12px;
                overflow-x: auto;
                box-shadow: 0 2px 15px rgba(0,0,0,0.06);
                margin-bottom: 30px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 750px;
            }

            th {
                background: var(--dark);
                color: white;
                padding: 14px 15px;
                text-align: left;
                font-size: 13px;
                font-weight: 600;
            }

            td {
                padding: 12px 15px;
                border-bottom: 1px solid #f0ece8;
                font-size: 13px;
                color: #333;
            }

            tr:hover td {
                background: #faf7f4;
            }

            .status-badge {
                display: inline-block;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: bold;
            }

            .status-active {
                background: var(--success);
                color: white;
            }

            .status-inactive {
                background: var(--danger);
                color: white;
            }

            .btn-view {
                padding: 5px 14px;
                border-radius: 5px;
                border: none;
                cursor: pointer;
                font-size: 11px;
                font-weight: bold;
                background: var(--gold);
                color: var(--dark);
                transition: all 0.3s;
            }

                .btn-view:hover {
                    transform: translateY(-1px);
                    opacity: 0.85;
                }

            /* ==================== MODAL ==================== */
            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

                .modal.show {
                    display: flex;
                }

            .modal-content {
                background: white;
                border-radius: 12px;
                max-width: 500px;
                width: 90%;
                max-height: 85vh;
                overflow-y: auto;
            }

            .modal-header {
                background: var(--dark);
                padding: 15px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                border-radius: 12px 12px 0 0;
            }

                .modal-header h3 {
                    color: var(--gold);
                    font-size: 18px;
                }

                .modal-header .close-modal {
                    background: none;
                    border: none;
                    color: white;
                    font-size: 24px;
                    cursor: pointer;
                }

            .modal-body {
                padding: 20px;
            }

            .detail-row {
                margin-bottom: 12px;
                padding-bottom: 8px;
                border-bottom: 1px solid #f0ece8;
            }

                .detail-row strong {
                    color: var(--gold);
                    display: inline-block;
                    width: 130px;
                }

            /* ==================== MOBILE RESPONSIVE ==================== */
            @@media (max-width: 1024px) {
                .stats-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 768px) {
                .sidebar-toggle {
                    display: block;
                }

                .sidebar {
                    left: -280px;
                    width: 280px;
                }

                    .sidebar.open {
                        left: 0;
                    }

                .main-content {
                    margin-left: 0;
                    padding: 70px 15px 20px;
                }

                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 15px;
                }

                .stat-card .stat-number {
                    font-size: 24px;
                }

                .page-header h2 {
                    font-size: 22px;
                }

                .sidebar-overlay.show {
                    display: block;
                }
            }

            @@media (max-width: 480px) {
                .stats-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <!-- Mobile Toggle Button -->
    <button class="sidebar-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- ==================== SIDEBAR ==================== -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1>URBANDRIVE</h1>
            <p>EXECUTIVE</p>
        </div>

        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav">
            <a href="/Admin/Dashboard" class="sidebar-link">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="/Admin/Vehicles" class="sidebar-link">
                <i class="fas fa-car"></i>
                <span>Vehicles</span>
            </a>
            <a href="/Admin/Drivers" class="sidebar-link">
                <i class="fas fa-users"></i>
                <span>Drivers</span>
            </a>
            <a href="/Admin/Users/Index" class="sidebar-link active">
                <i class="fas fa-user-friends"></i>
                <span>Users</span>
            </a>
            <a href="/Admin/Bookings" class="sidebar-link">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </a>
            <a href="/Admin/FuelRecords" class="sidebar-link">
                <i class="fas fa-gas-pump"></i>
                <span>Fuel Records</span>
            </a>
            <a href="/Admin/FuelPriceSettings" class="sidebar-link">
                <i class="fas fa-sliders-h"></i>
                <span>Fuel Price</span>
            </a>
            <a href="/Admin/TripReports" class="sidebar-link">
                <i class="fas fa-file-alt"></i>
                <span>Trip Reports</span>
            </a>
        </nav>

        <div class="sidebar-divider"></div>

        <div class="sidebar-footer">
            <a href="/Admin/Logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
            <div class="sidebar-user">
                <i class="fas fa-user-circle"></i>
                <span>@User.Identity?.Name ?? "Admin"</span>
            </div>
        </div>
    </div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="main-content">
        <div class="page-header">
            <h2><i class="fas fa-user-friends" style="color: var(--gold); margin-right: 10px;"></i> Registered Users</h2>
            <p>View and manage all registered users of the UrbanDrive system</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card card-blue">
                <i class="fas fa-users stat-icon"></i>
                <div class="stat-label">Total Users</div>
                <div class="stat-number">@Model.Count</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> Registered accounts
                </div>
            </div>

            <div class="stat-card card-green">
                <i class="fas fa-user-check stat-icon"></i>
                <div class="stat-label">Active Users</div>
                <div class="stat-number">@Model.Count(u => u.IsActive)</div>
                <div class="stat-change positive">
                    <i class="fas fa-check"></i> Active accounts
                </div>
            </div>

            <div class="stat-card card-orange">
                <i class="fas fa-user-slash stat-icon"></i>
                <div class="stat-label">Inactive Users</div>
                <div class="stat-number">@Model.Count(u => !u.IsActive)</div>
                <div class="stat-change negative">
                    <i class="fas fa-arrow-down"></i> Inactive accounts
                </div>
            </div>

            <div class="stat-card card-purple">
                <i class="fas fa-calendar-alt stat-icon"></i>
                <div class="stat-label">New This Month</div>
                @{
                    var startOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                    var newUsers = Model.Count(u => u.RegisteredAt >= startOfMonth);
                }
                <div class="stat-number">@newUsers</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> New registrations
                </div>
            </div>
        </div>

        <!-- Users Table -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Role</th>
                        <th>Registered On</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><strong>@user.UserId</strong></td>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@(user.PhoneNumber ?? "N/A")</td>
                            <td>@user.Role</td>
                            <td>@user.RegisteredAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="status-badge @(user.IsActive ? "status-active" : "status-inactive")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <button class="btn-view" onclick="viewUser(@user.UserId)">
                                    <i class="fas fa-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- View User Modal -->
    <div id="viewUserModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-user"></i> User Details</h3>
                <button class="close-modal" onclick="closeViewUserModal()">✕</button>
            </div>
            <div class="modal-body" id="viewUserModalBody"></div>
        </div>
    </div>

    <script>
            // ==================== SIDEBAR ====================
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('open');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            // Close sidebar on link click (mobile)
            document.querySelectorAll('.sidebar-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth <= 768) {
                        document.getElementById('sidebar').classList.remove('open');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });

            // ==================== VIEW USER ====================
            async function viewUser(id) {
                const response = await fetch(`/Admin/GetUserDetails/${id}`);
                const user = await response.json();

                if (user.success) {
                    const html = `
                        <div class="detail-row"><strong>User ID:</strong> ${user.userId}</div>
                        <div class="detail-row"><strong>Full Name:</strong> ${user.fullName}</div>
                        <div class="detail-row"><strong>Email:</strong> ${user.email}</div>
                        <div class="detail-row"><strong>Phone Number:</strong> ${user.phoneNumber || 'N/A'}</div>
                        <div class="detail-row"><strong>Role:</strong> ${user.role}</div>
                        <div class="detail-row"><strong>Status:</strong> ${user.isActive ? 'Active' : 'Inactive'}</div>
                        <div class="detail-row"><strong>Registered On:</strong> ${user.registeredAt}</div>
                        <div class="detail-row"><strong>Last Login:</strong> ${user.lastLoginAt || 'Never'}</div>
                        <div class="detail-row"><strong>Total Bookings:</strong> ${user.totalBookings}</div>
                    `;
                    document.getElementById('viewUserModalBody').innerHTML = html;
                    document.getElementById('viewUserModal').classList.add('show');
                } else {
                    alert('Failed to load user details');
                }
            }

            function closeViewUserModal() {
                document.getElementById('viewUserModal').classList.remove('show');
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeViewUserModal();
                }
            });
    </script>

</body>
</html>