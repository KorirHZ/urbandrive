@{
    ViewData["Title"] = "Fuel Price Settings - UrbanDrive";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Fuel Price Settings</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f0eb;
                display: flex;
                min-height: 100vh;
                overflow-x: hidden;
            }

            :root {
                --sidebar-width: 250px;
                --gold: #DAA520;
                --dark: #1a1a2e;
                --white: #ffffff;
            }

            /* ==================== SIDEBAR ==================== */
            .sidebar {
                width: var(--sidebar-width);
                background: var(--dark);
                color: white;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                display: flex;
                flex-direction: column;
                transition: left 0.3s ease;
                z-index: 1000;
                overflow-x: hidden;
            }

            .sidebar-brand {
                padding: 20px;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

                .sidebar-brand h1 {
                    color: var(--gold);
                    font-size: 22px;
                    letter-spacing: 2px;
                }

                .sidebar-brand p {
                    color: rgba(255,255,255,0.5);
                    font-size: 10px;
                    letter-spacing: 3px;
                }

            .sidebar-divider {
                height: 1px;
                background: rgba(255,255,255,0.05);
                margin: 10px 20px;
            }

            .sidebar-nav {
                flex: 1;
                padding: 10px 0;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 12px 25px;
                color: rgba(255,255,255,0.7);
                text-decoration: none;
                transition: all 0.3s;
                font-size: 14px;
                border-left: 3px solid transparent;
            }

                .sidebar-link:hover {
                    background: rgba(255,255,255,0.05);
                    color: white;
                }

                .sidebar-link.active {
                    background: rgba(218, 165, 32, 0.1);
                    color: var(--gold);
                    border-left-color: var(--gold);
                }

                .sidebar-link i {
                    width: 20px;
                    font-size: 16px;
                }

            .sidebar-footer {
                padding: 15px 20px;
                border-top: 1px solid rgba(255,255,255,0.05);
            }

            .sidebar-user {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,0.7);
                font-size: 14px;
                margin-top: 10px;
            }

                .sidebar-user i {
                    font-size: 28px;
                    color: var(--gold);
                }

            .sidebar-toggle {
                display: none;
                position: fixed;
                top: 15px;
                left: 15px;
                z-index: 1100;
                background: var(--dark);
                color: var(--gold);
                border: none;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 20px;
                cursor: pointer;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
            }

                .sidebar-overlay.show {
                    display: block;
                }

            /* ==================== MAIN CONTENT ==================== */
            .main-content {
                margin-left: var(--sidebar-width);
                flex: 1;
                padding: 25px 30px;
                transition: margin-left 0.3s ease;
                min-height: 100vh;
            }

            .page-header {
                margin-bottom: 25px;
            }

                .page-header h2 {
                    font-size: 28px;
                    color: var(--dark);
                    border-left: 4px solid var(--gold);
                    padding-left: 15px;
                }

                .page-header p {
                    color: #666;
                    font-size: 14px;
                    margin-top: 5px;
                    padding-left: 19px;
                }

            .card {
                background: var(--white);
                border-radius: 12px;
                padding: 30px;
                max-width: 550px;
                box-shadow: 0 2px 15px rgba(0,0,0,0.06);
            }

            .current-price {
                background: #f8f4f0;
                padding: 20px;
                border-radius: 10px;
                margin-bottom: 25px;
                text-align: center;
                border: 1px solid #e8e0d8;
            }

                .current-price h3 {
                    color: var(--dark);
                    font-size: 16px;
                    margin-bottom: 5px;
                }

                .current-price .price {
                    font-size: 36px;
                    font-weight: bold;
                    color: var(--gold);
                }

                .current-price small {
                    color: #999;
                    font-size: 13px;
                }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 8px;
                    font-weight: 600;
                    color: var(--dark);
                }

                    .form-group label i {
                        color: var(--gold);
                        margin-right: 8px;
                    }

                .form-group input {
                    width: 100%;
                    padding: 12px 15px;
                    border: 2px solid #e0d8d0;
                    border-radius: 8px;
                    font-size: 18px;
                    transition: all 0.3s;
                    background: var(--white);
                }

                    .form-group input:focus {
                        outline: none;
                        border-color: var(--gold);
                        box-shadow: 0 0 0 3px rgba(218, 165, 32, 0.2);
                    }

            .btn-save {
                width: 100%;
                padding: 14px;
                background: var(--gold);
                color: var(--dark);
                border: none;
                border-radius: 8px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                transition: all 0.3s;
            }

                .btn-save:hover {
                    background: #e6b800;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 15px rgba(218, 165, 32, 0.3);
                }

            .info-box {
                margin-top: 20px;
                padding: 15px;
                background: #f8f4f0;
                border-radius: 8px;
                font-size: 13px;
                color: #666;
                border: 1px solid #e8e0d8;
            }

                .info-box i {
                    color: var(--gold);
                    margin-right: 8px;
                }

            .alert {
                padding: 12px 15px;
                border-radius: 8px;
                margin-bottom: 20px;
                font-size: 14px;
            }

            .alert-success {
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
            }

            .alert-danger {
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
            }

            @@media (max-width: 768px) {
                .sidebar-toggle {
                    display: block;
                }

                .sidebar {
                    left: -280px;
                    width: 280px;
                }

                    .sidebar.open {
                        left: 0;
                    }

                .main-content {
                    margin-left: 0;
                    padding: 70px 15px 20px;
                }

                .page-header h2 {
                    font-size: 22px;
                }

                .card {
                    padding: 20px;
                }

                .current-price .price {
                    font-size: 28px;
                }

                .sidebar-overlay.show {
                    display: block;
                }
            }
    </style>
</head>
<body>

    <!-- Mobile Toggle -->
    <button class="sidebar-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- ==================== SIDEBAR ==================== -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1>URBANDRIVE</h1>
            <p>EXECUTIVE</p>
        </div>

        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav">
            <a href="/Admin/Dashboard" class="sidebar-link">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="/Admin/Vehicles" class="sidebar-link">
                <i class="fas fa-car"></i>
                <span>Vehicles</span>
            </a>
            <a href="/Admin/Drivers" class="sidebar-link">
                <i class="fas fa-users"></i>
                <span>Drivers</span>
            </a>
            <a href="/Admin/Users/Index" class="sidebar-link">
                <i class="fas fa-user-friends"></i>
                <span>Users</span>
            </a>
            <a href="/Admin/Bookings" class="sidebar-link">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </a>
            <a href="/Admin/FuelRecords" class="sidebar-link">
                <i class="fas fa-gas-pump"></i>
                <span>Fuel Records</span>
            </a>
            <a href="/Admin/FuelPriceSettings" class="sidebar-link active">
                <i class="fas fa-sliders-h"></i>
                <span>Fuel Price</span>
            </a>
            <a href="/Admin/TripReports" class="sidebar-link">
                <i class="fas fa-file-alt"></i>
                <span>Trip Reports</span>
            </a>
        </nav>

        <div class="sidebar-divider"></div>

        <div class="sidebar-footer">
            <a href="/Admin/Logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
            <div class="sidebar-user">
                <i class="fas fa-user-circle"></i>
                <span>@User.Identity?.Name ?? "Admin"</span>
            </div>
        </div>
    </div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="main-content">
        <div class="page-header">
            <h2><i class="fas fa-sliders-h" style="color: var(--gold); margin-right: 10px;"></i> Fuel Price Settings</h2>
            <p>Manage the fuel price per liter used for cost calculations</p>
        </div>

        <div class="card">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="current-price">
                <h3><i class="fas fa-tachometer-alt" style="color: var(--gold);"></i> Current Price Per Liter</h3>
                <div class="price">KES @ViewBag.CurrentPrice</div>
                <small>This price is used to calculate fuel costs for all trips</small>
            </div>

            <form method="post" action="/Admin/UpdateFuelPrice">
                <div class="form-group">
                    <label><i class="fas fa-money-bill-wave"></i> New Price Per Liter</label>
                    <input type="number" name="pricePerLiter" step="0.01" min="0" value="@ViewBag.CurrentPrice" required>
                </div>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> Update Fuel Price
                </button>
            </form>

            <div class="info-box">
                <i class="fas fa-info-circle"></i>
                <strong>Note:</strong> Updating the price will automatically recalculate costs for ALL existing fuel records. This ensures all historical data remains consistent with the current fuel price.
            </div>
        </div>
    </div>

    <script>
            // ==================== SIDEBAR ====================
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('open');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            document.querySelectorAll('.sidebar-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth <= 768) {
                        document.getElementById('sidebar').classList.remove('open');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });
    </script>

</body>
</html>