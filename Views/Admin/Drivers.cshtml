@{
    ViewData["Title"] = "Driver Management - UrbanDrive";
    Layout = null;
}

@model UrbanDrive.Models.DriverManagementViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Driver Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f0eb;
                display: flex;
                min-height: 100vh;
                overflow-x: hidden;
            }

            :root {
                --sidebar-width: 250px;
                --gold: #DAA520;
                --dark: #1a1a2e;
                --cream: #f5f0eb;
                --white: #ffffff;
                --success: #27ae60;
                --danger: #e74c3c;
                --warning: #f39c12;
                --info: #3498db;
            }

            /* ==================== SIDEBAR ==================== */
            .sidebar {
                width: var(--sidebar-width);
                background: var(--dark);
                color: white;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                display: flex;
                flex-direction: column;
                transition: left 0.3s ease;
                z-index: 1000;
                overflow-x: hidden;
            }

            .sidebar-brand {
                padding: 20px;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

                .sidebar-brand h1 {
                    color: var(--gold);
                    font-size: 22px;
                    letter-spacing: 2px;
                }

                .sidebar-brand p {
                    color: rgba(255,255,255,0.5);
                    font-size: 10px;
                    letter-spacing: 3px;
                }

            .sidebar-divider {
                height: 1px;
                background: rgba(255,255,255,0.05);
                margin: 10px 20px;
            }

            .sidebar-nav {
                flex: 1;
                padding: 10px 0;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 12px 25px;
                color: rgba(255,255,255,0.7);
                text-decoration: none;
                transition: all 0.3s;
                font-size: 14px;
                border-left: 3px solid transparent;
            }

                .sidebar-link:hover {
                    background: rgba(255,255,255,0.05);
                    color: white;
                }

                .sidebar-link.active {
                    background: rgba(218, 165, 32, 0.1);
                    color: var(--gold);
                    border-left-color: var(--gold);
                }

                .sidebar-link i {
                    width: 20px;
                    font-size: 16px;
                }

            .sidebar-footer {
                padding: 15px 20px;
                border-top: 1px solid rgba(255,255,255,0.05);
            }

            .sidebar-user {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,0.7);
                font-size: 14px;
                margin-top: 10px;
            }

                .sidebar-user i {
                    font-size: 28px;
                    color: var(--gold);
                }

            /* Mobile Toggle */
            .sidebar-toggle {
                display: none;
                position: fixed;
                top: 15px;
                left: 15px;
                z-index: 1100;
                background: var(--dark);
                color: var(--gold);
                border: none;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 20px;
                cursor: pointer;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
            }

                .sidebar-overlay.show {
                    display: block;
                }

            /* ==================== MAIN CONTENT ==================== */
            .main-content {
                margin-left: var(--sidebar-width);
                flex: 1;
                padding: 25px 30px;
                transition: margin-left 0.3s ease;
                min-height: 100vh;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
            }

                .page-header h2 {
                    font-size: 28px;
                    color: var(--dark);
                    border-left: 4px solid var(--gold);
                    padding-left: 15px;
                }

                .page-header p {
                    color: #666;
                    font-size: 14px;
                    margin-top: 5px;
                    padding-left: 19px;
                }

            .btn-add {
                background: var(--gold);
                color: var(--dark);
                border: none;
                padding: 10px 20px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: bold;
                transition: all 0.3s;
            }

                .btn-add:hover {
                    background: #e6b800;
                    transform: translateY(-1px);
                }

            /* ==================== STATS CARDS ==================== */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
                margin-bottom: 30px;
            }

            .stat-card {
                border-radius: 15px;
                padding: 22px 25px;
                color: white;
                position: relative;
                overflow: hidden;
                transition: transform 0.3s;
                cursor: default;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            }

                .stat-card:hover {
                    transform: translateY(-5px);
                }

                .stat-card .stat-icon {
                    position: absolute;
                    right: 15px;
                    top: 15px;
                    font-size: 40px;
                    opacity: 0.2;
                }

                .stat-card .stat-label {
                    font-size: 13px;
                    opacity: 0.8;
                    margin-bottom: 5px;
                    font-weight: 500;
                }

                .stat-card .stat-number {
                    font-size: 32px;
                    font-weight: bold;
                }

                .stat-card .stat-change {
                    font-size: 12px;
                    margin-top: 8px;
                    opacity: 0.9;
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }

            .stat-change.positive {
                color: #a8e6cf;
            }

            .stat-change.negative {
                color: #ff6b6b;
            }

            /* Card Gradients */
            .card-blue {
                background: linear-gradient(135deg, #2193b0, #6dd5ed);
            }

            .card-green {
                background: linear-gradient(135deg, #11998e, #38ef7d);
            }

            .card-orange {
                background: linear-gradient(135deg, #f12711, #f5af19);
            }

            .card-purple {
                background: linear-gradient(135deg, #8E2DE2, #4A00E0);
            }

            /* ==================== TABLE ==================== */
            .table-container {
                background: var(--white);
                border-radius: 12px;
                overflow-x: auto;
                box-shadow: 0 2px 15px rgba(0,0,0,0.06);
                margin-bottom: 30px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 800px;
            }

            th {
                background: var(--dark);
                color: white;
                padding: 14px 15px;
                text-align: left;
                font-size: 13px;
                font-weight: 600;
            }

            td {
                padding: 12px 15px;
                border-bottom: 1px solid #f0ece8;
                font-size: 13px;
                color: #333;
            }

            tr:hover td {
                background: #faf7f4;
            }

            .status-badge {
                display: inline-block;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: bold;
            }

            .status-available {
                background: var(--success);
                color: white;
            }

            .status-unavailable {
                background: var(--danger);
                color: white;
            }

            .btn-sm {
                padding: 5px 12px;
                border-radius: 5px;
                border: none;
                cursor: pointer;
                font-size: 11px;
                font-weight: bold;
                transition: all 0.3s;
            }

            .btn-edit {
                background: var(--info);
                color: white;
            }

            .btn-delete {
                background: var(--danger);
                color: white;
            }

            .btn-reset {
                background: var(--warning);
                color: white;
            }

            .btn-sm:hover {
                transform: translateY(-1px);
                opacity: 0.85;
            }

            /* ==================== MODAL ==================== */
            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

                .modal.show {
                    display: flex;
                }

            .modal-content {
                background: white;
                border-radius: 12px;
                max-width: 550px;
                width: 90%;
                max-height: 85vh;
                overflow-y: auto;
            }

            .modal-header {
                background: var(--dark);
                padding: 15px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                border-radius: 12px 12px 0 0;
            }

                .modal-header h3 {
                    color: var(--gold);
                    font-size: 18px;
                }

                .modal-header .close-modal {
                    background: none;
                    border: none;
                    color: white;
                    font-size: 24px;
                    cursor: pointer;
                }

            .modal-body {
                padding: 20px;
            }

            .form-group {
                margin-bottom: 15px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 5px;
                    font-weight: bold;
                    font-size: 13px;
                }

                    .form-group label i {
                        color: var(--gold);
                        margin-right: 5px;
                    }

                .form-group input,
                .form-group select,
                .form-group textarea {
                    width: 100%;
                    padding: 10px;
                    border: 1px solid #ddd;
                    border-radius: 8px;
                    font-size: 14px;
                }

                .form-group textarea {
                    resize: vertical;
                    min-height: 60px;
                }

            .form-row {
                display: flex;
                gap: 15px;
            }

                .form-row .form-group {
                    flex: 1;
                }

            .password-hint {
                font-size: 11px;
                color: #666;
                margin-top: 5px;
            }

            /* ==================== MOBILE ==================== */
            @@media (max-width: 1024px) {
                .stats-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 768px) {
                .sidebar-toggle {
                    display: block;
                }

                .sidebar {
                    left: -280px;
                    width: 280px;
                }

                    .sidebar.open {
                        left: 0;
                    }

                .main-content {
                    margin-left: 0;
                    padding: 70px 15px 20px;
                }

                .page-header {
                    flex-direction: column;
                    gap: 15px;
                    align-items: flex-start;
                }

                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 15px;
                }

                .stat-card .stat-number {
                    font-size: 24px;
                }

                .page-header h2 {
                    font-size: 22px;
                }

                .form-row {
                    flex-direction: column;
                    gap: 10px;
                }

                .sidebar-overlay.show {
                    display: block;
                }
            }

            @@media (max-width: 480px) {
                .stats-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <!-- Mobile Toggle Button -->
    <button class="sidebar-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- ==================== SIDEBAR ==================== -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1>URBANDRIVE</h1>
            <p>EXECUTIVE</p>
        </div>

        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav">
            <a href="/Admin/Dashboard" class="sidebar-link">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="/Admin/Vehicles" class="sidebar-link">
                <i class="fas fa-car"></i>
                <span>Vehicles</span>
            </a>
            <a href="/Admin/Drivers" class="sidebar-link active">
                <i class="fas fa-users"></i>
                <span>Drivers</span>
            </a>
            <a href="/Admin/Users/Index" class="sidebar-link">
                <i class="fas fa-user-friends"></i>
                <span>Users</span>
            </a>
            <a href="/Admin/Bookings" class="sidebar-link">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </a>
            <a href="/Admin/FuelRecords" class="sidebar-link">
                <i class="fas fa-gas-pump"></i>
                <span>Fuel Records</span>
            </a>
            <a href="/Admin/FuelPriceSettings" class="sidebar-link">
                <i class="fas fa-sliders-h"></i>
                <span>Fuel Price</span>
            </a>
            <a href="/Admin/TripReports" class="sidebar-link">
                <i class="fas fa-file-alt"></i>
                <span>Trip Reports</span>
            </a>
        </nav>

        <div class="sidebar-divider"></div>

        <div class="sidebar-footer">
            <a href="/Admin/Logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
            <div class="sidebar-user">
                <i class="fas fa-user-circle"></i>
                <span>@User.Identity?.Name ?? "Admin"</span>
            </div>
        </div>
    </div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="main-content">
        <div class="page-header">
            <div>
                <h2><i class="fas fa-users" style="color: var(--gold); margin-right: 10px;"></i> Driver Management</h2>
                <p>Manage all drivers, their availability, and license information</p>
            </div>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> Add New Driver</button>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card card-blue">
                <i class="fas fa-users stat-icon"></i>
                <div class="stat-label">Total Drivers</div>
                <div class="stat-number">@Model.TotalDrivers</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> Registered drivers
                </div>
            </div>

            <div class="stat-card card-green">
                <i class="fas fa-user-check stat-icon"></i>
                <div class="stat-label">Available Drivers</div>
                <div class="stat-number">@Model.AvailableDrivers</div>
                <div class="stat-change positive">
                    <i class="fas fa-check"></i> Ready for assignment
                </div>
            </div>

            <div class="stat-card card-orange">
                <i class="fas fa-user-clock stat-icon"></i>
                <div class="stat-label">Unavailable Drivers</div>
                <div class="stat-number">@Model.UnavailableDrivers</div>
                <div class="stat-change negative">
                    <i class="fas fa-clock"></i> Currently unavailable
                </div>
            </div>

            <div class="stat-card card-purple">
                <i class="fas fa-id-card stat-icon"></i>
                <div class="stat-label">License Expiring Soon</div>
                @{
                    var expiringSoon = Model.Drivers.Count(d => d.LicenseExpiryDate.HasValue && d.LicenseExpiryDate.Value <= DateTime.Now.AddDays(30));
                }
                <div class="stat-number">@expiringSoon</div>
                <div class="stat-change negative">
                    <i class="fas fa-exclamation-triangle"></i> Expiring in 30 days
                </div>
            </div>
        </div>

        <!-- Drivers Table -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>License</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var driver in Model.Drivers)
                    {
                        <tr>
                            <td><strong>@driver.DriverId</strong></td>
                            <td>@driver.FullName</td>
                            <td>@driver.Email</td>
                            <td>@driver.PhoneNumber</td>
                            <td>@driver.LicenseNumber</td>
                            <td>
                                @if (driver.IsAvailable)
                                {
                                    <span class="status-badge status-available"><i class="fas fa-check-circle"></i> Available</span>
                                }
                                else
                                {
                                    <span class="status-badge status-unavailable"><i class="fas fa-ban"></i> Unavailable</span>
                                }
                            </td>
                            <td>
                                <button class="btn-sm btn-edit" onclick="openEditModal(@driver.DriverId)"><i class="fas fa-edit"></i> Edit</button>
                                <button class="btn-sm btn-reset" onclick="openSetPasswordModal(@driver.DriverId, '@driver.FullName')"><i class="fas fa-key"></i> Set Password</button>
                                <button class="btn-sm btn-delete" onclick="deleteDriver(@driver.DriverId)"><i class="fas fa-trash"></i> Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ==================== MODALS ==================== -->
    <!-- Add/Edit Driver Modal -->
    <div id="driverModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle"><i class="fas fa-user-plus"></i> Add Driver</h3>
                <button class="close-modal" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="driverId">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Full Name</label>
                    <input type="text" id="fullName" placeholder="Enter full name">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-envelope"></i> Email</label>
                    <input type="email" id="email" placeholder="driver@example.com">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-phone"></i> Phone</label>
                        <input type="tel" id="phoneNumber" placeholder="0712345678">
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-id-card"></i> License Number</label>
                        <input type="text" id="licenseNumber" placeholder="B12345">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-calendar-alt"></i> License Expiry</label>
                        <input type="date" id="licenseExpiryDate">
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-calendar"></i> Hire Date</label>
                        <input type="date" id="hireDate">
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-toggle-on"></i> Availability</label>
                    <select id="isAvailable">
                        <option value="true">Available</option>
                        <option value="false">Unavailable</option>
                    </select>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-comment"></i> Notes</label>
                    <textarea id="notes" rows="2" placeholder="Additional notes..."></textarea>
                </div>
                <button class="btn-add" onclick="saveDriver()" style="width:100%;"><i class="fas fa-save"></i> Save Driver</button>
            </div>
        </div>
    </div>

    <!-- Set Password Modal -->
    <div id="setPasswordModal" class="modal">
        <div class="modal-content" style="max-width: 450px;">
            <div class="modal-header">
                <h3><i class="fas fa-key"></i> Set Driver Password</h3>
                <button class="close-modal" onclick="closePasswordModal()">✕</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="setPasswordDriverId">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Driver Name</label>
                    <input type="text" id="setPasswordDriverName" class="form-control" disabled style="background:#f5f5f5;">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-lock"></i> New Password</label>
                    <input type="password" id="newPassword" class="form-control" placeholder="Enter new password">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-check-circle"></i> Confirm Password</label>
                    <input type="password" id="confirmNewPassword" class="form-control" placeholder="Confirm new password">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-eye"></i> Show Password</label>
                    <input type="checkbox" id="showPasswordCheckbox" onclick="togglePasswordVisibility()"> <span style="font-size:12px;">Show password</span>
                </div>
                <div class="password-hint">
                    <i class="fas fa-info-circle"></i> Password must be at least 6 characters.
                </div>
                <button class="btn-add" onclick="setDriverPassword()" style="width:100%; margin-top:15px;">
                    <i class="fas fa-save"></i> Set Password
                </button>
            </div>
        </div>
    </div>

    <script>
            // ==================== SIDEBAR ====================
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('open');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            document.querySelectorAll('.sidebar-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth <= 768) {
                        document.getElementById('sidebar').classList.remove('open');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });

            // ==================== DRIVER MODAL ====================
            function openAddModal() {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-user-plus"></i> Add Driver';
                document.getElementById('driverId').value = '';
                document.getElementById('fullName').value = '';
                document.getElementById('email').value = '';
                document.getElementById('phoneNumber').value = '';
                document.getElementById('licenseNumber').value = '';
                document.getElementById('licenseExpiryDate').value = '';
                document.getElementById('hireDate').value = '';
                document.getElementById('isAvailable').value = 'true';
                document.getElementById('notes').value = '';
                document.getElementById('driverModal').classList.add('show');
            }

            async function openEditModal(driverId) {
                const response = await fetch(`/Admin/GetDriver/${driverId}`);
                const driver = await response.json();
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-user-edit"></i> Edit Driver';
                document.getElementById('driverId').value = driver.driverId;
                document.getElementById('fullName').value = driver.fullName;
                document.getElementById('email').value = driver.email;
                document.getElementById('phoneNumber').value = driver.phoneNumber;
                document.getElementById('licenseNumber').value = driver.licenseNumber;
                document.getElementById('licenseExpiryDate').value = driver.licenseExpiryDate?.split('T')[0] || '';
                document.getElementById('hireDate').value = driver.hireDate?.split('T')[0] || '';
                document.getElementById('isAvailable').value = driver.isAvailable ? 'true' : 'false';
                document.getElementById('notes').value = driver.notes || '';
                document.getElementById('driverModal').classList.add('show');
            }

            async function saveDriver() {
                const driverId = document.getElementById('driverId').value;
                const data = {
                    driverId: driverId || 0,
                    fullName: document.getElementById('fullName').value,
                    email: document.getElementById('email').value,
                    phoneNumber: document.getElementById('phoneNumber').value,
                    licenseNumber: document.getElementById('licenseNumber').value,
                    licenseExpiryDate: document.getElementById('licenseExpiryDate').value,
                    hireDate: document.getElementById('hireDate').value,
                    isAvailable: document.getElementById('isAvailable').value === 'true',
                    notes: document.getElementById('notes').value
                };
                const url = driverId ? '/Admin/UpdateDriver' : '/Admin/CreateDriver';
                const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            }

            async function deleteDriver(driverId) {
                if (!confirm('Delete this driver? This action cannot be undone.')) return;
                const response = await fetch('/Admin/DeleteDriver', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ driverId }) });
                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            }

            // ==================== SET PASSWORD ====================
            function openSetPasswordModal(driverId, driverName) {
                document.getElementById('setPasswordDriverId').value = driverId;
                document.getElementById('setPasswordDriverName').value = driverName;
                document.getElementById('newPassword').value = '';
                document.getElementById('confirmNewPassword').value = '';
                document.getElementById('showPasswordCheckbox').checked = false;
                document.getElementById('setPasswordModal').classList.add('show');
            }

            function closePasswordModal() {
                document.getElementById('setPasswordModal').classList.remove('show');
            }

            function togglePasswordVisibility() {
                var passwordField = document.getElementById('newPassword');
                var confirmField = document.getElementById('confirmNewPassword');
                var checkbox = document.getElementById('showPasswordCheckbox');

                if (checkbox.checked) {
                    passwordField.type = 'text';
                    confirmField.type = 'text';
                } else {
                    passwordField.type = 'password';
                    confirmField.type = 'password';
                }
            }

            async function setDriverPassword() {
                var driverId = document.getElementById('setPasswordDriverId').value;
                var newPassword = document.getElementById('newPassword').value;
                var confirmPassword = document.getElementById('confirmNewPassword').value;

                if (!newPassword || !confirmPassword) {
                    alert('Please enter a password');
                    return;
                }

                if (newPassword !== confirmPassword) {
                    alert('Passwords do not match!');
                    return;
                }

                if (newPassword.length < 6) {
                    alert('Password must be at least 6 characters');
                    return;
                }

                const response = await fetch('/Admin/SetDriverPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ driverId: parseInt(driverId), newPassword: newPassword })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Password set successfully! The driver can now login with this password.');
                    closePasswordModal();
                } else {
                    alert('Error: ' + result.message);
                }
            }

            function closeModal() {
                document.getElementById('driverModal').classList.remove('show');
            }
    </script>

</body>
</html>