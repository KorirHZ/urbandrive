@{
    ViewData["Title"] = "Fuel Records - UrbanDrive";
    Layout = null;
}

@model List<UrbanDrive.Models.FuelRecord>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Fuel Records</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                background: #f5f5f5;
            }

            :root {
                --black: #1a1a1a;
                --gold: #DAA520;
                --white: #FFFFFF;
                --success: #27ae60;
                --danger: #e74c3c;
                --info: #3498db;
            }

            .navbar {
                background: var(--black);
                padding: 12px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1000;
            }

            .logo h1 {
                color: var(--gold);
                font-size: 20px;
            }

            .logo p {
                color: var(--white);
                font-size: 8px;
                letter-spacing: 2px;
            }

            .nav-links a {
                color: white;
                text-decoration: none;
                margin-left: 20px;
            }

                .nav-links a:hover, .nav-links a.active {
                    color: var(--gold);
                }

            .mobile-menu-btn {
                display: none;
                background: none;
                border: none;
                color: var(--gold);
                font-size: 24px;
                cursor: pointer;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: -280px;
                width: 280px;
                height: 100%;
                background: var(--black);
                z-index: 2000;
                transition: left 0.3s;
                padding: 80px 20px 20px;
            }

                .sidebar.open {
                    left: 0;
                }

                .sidebar a {
                    display: flex;
                    gap: 12px;
                    color: white;
                    text-decoration: none;
                    padding: 14px 0;
                    border-bottom: 1px solid #333;
                }

                    .sidebar a i {
                        width: 25px;
                        color: var(--gold);
                    }

            .close-sidebar {
                position: absolute;
                top: 20px;
                right: 20px;
                background: none;
                border: none;
                color: var(--gold);
                font-size: 24px;
                cursor: pointer;
            }

            .overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 1500;
                display: none;
            }

                .overlay.show {
                    display: block;
                }

            .container {
                margin-top: 70px;
                padding: 20px;
            }

            .page-header {
                margin-bottom: 25px;
            }

                .page-header h2 {
                    border-left: 4px solid var(--gold);
                    padding-left: 15px;
                }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 15px;
                margin-bottom: 25px;
            }

            .stat-card {
                background: white;
                padding: 15px;
                border-radius: 12px;
                text-align: center;
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            }

                .stat-card i {
                    font-size: 28px;
                    color: var(--gold);
                }

                .stat-card h3 {
                    font-size: 22px;
                }

                .stat-card p {
                    font-size: 12px;
                    color: #666;
                }

            .filter-card {
                background: white;
                padding: 20px;
                border-radius: 12px;
                margin-bottom: 25px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            }

            .filter-form {
                display: flex;
                gap: 15px;
                flex-wrap: wrap;
                align-items: flex-end;
            }

            .filter-group {
                flex: 1;
                min-width: 150px;
            }

                .filter-group label {
                    display: block;
                    margin-bottom: 5px;
                    font-weight: bold;
                    font-size: 12px;
                }

                .filter-group input, .filter-group select {
                    width: 100%;
                    padding: 8px;
                    border: 1px solid #ddd;
                    border-radius: 8px;
                }

            .btn-filter {
                background: var(--gold);
                color: var(--black);
                border: none;
                padding: 8px 20px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: bold;
            }

            .btn-reset {
                background: #666;
                color: white;
                border: none;
                padding: 8px 20px;
                border-radius: 8px;
                cursor: pointer;
                text-decoration: none;
                display: inline-block;
            }

            .table-container {
                background: white;
                border-radius: 12px;
                overflow-x: auto;
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 800px;
            }

            th {
                background: var(--black);
                color: white;
                padding: 12px;
                text-align: left;
            }

            td {
                padding: 10px;
                border-bottom: 1px solid #eee;
            }

            tr:hover {
                background: #f9f9f9;
            }

            .btn-view {
                background: var(--gold);
                color: black;
                border: none;
                padding: 5px 12px;
                border-radius: 5px;
                cursor: pointer;
            }

            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 3000;
                justify-content: center;
                align-items: center;
            }

                .modal.show {
                    display: flex;
                }

            .modal-content {
                background: white;
                border-radius: 12px;
                max-width: 500px;
                width: 90%;
            }

            .modal-header {
                background: var(--black);
                padding: 15px 20px;
                display: flex;
                justify-content: space-between;
                border-radius: 12px 12px 0 0;
            }

                .modal-header h3 {
                    color: var(--gold);
                }

            .close-modal {
                background: none;
                border: none;
                color: white;
                font-size: 24px;
                cursor: pointer;
            }

            .modal-body {
                padding: 20px;
            }

            .detail-row {
                margin-bottom: 12px;
                padding-bottom: 8px;
                border-bottom: 1px solid #eee;
            }

                .detail-row strong {
                    color: var(--gold);
                    display: inline-block;
                    width: 130px;
                }

            @@media (max-width: 992px) {
                .nav-links {
                    display: none;
                }

                .mobile-menu-btn {
                    display: block;
                }
            }

            @@media (max-width: 768px) {
                .container {
                    padding: 15px;
                    margin-top: 60px;
                }

                .stats-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .filter-form {
                    flex-direction: column;
                }

                .filter-group {
                    width: 100%;
                }
            }
    </style>
</head>
<body>

    <div class="sidebar" id="mobileSidebar">
        <button class="close-sidebar" onclick="closeSidebar()">✕</button>
        <a href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/Admin/Drivers"><i class="fas fa-users"></i> Drivers</a>
        <a href="/Admin/Vehicles"><i class="fas fa-car"></i> Vehicles</a>
        <a href="/Admin/Users/Index"><i class="fas fa-user-friends"></i> Users</a>
        <a href="/Admin/FuelRecords" class="active"><i class="fas fa-gas-pump"></i> Fuel Records</a>
        <a href="/Admin/TripReports"><i class="fas fa-file-alt"></i> Trip Reports</a>
        <a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
    <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

    <div class="navbar">
        <div class="logo">
            <a href="/" style="text-decoration:none;">
                <h1>URBANDRIVE</h1>
                <p>EXECUTIVE</p>
            </a>
        </div>
        <div class="nav-links">
            <a href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a href="/Admin/Drivers"><i class="fas fa-users"></i> Drivers</a>
            <a href="/Admin/Vehicles"><i class="fas fa-car"></i> Vehicles</a>
            <a href="/Admin/Users/Index"><i class="fas fa-user-friends"></i> Users</a>
            <a href="/Admin/FuelRecords" class="active"><i class="fas fa-gas-pump"></i> Fuel</a>
            <a href="/Admin/TripReports"><i class="fas fa-file-alt"></i> Reports</a>
            <a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
        <button class="mobile-menu-btn" onclick="openSidebar()"><i class="fas fa-bars"></i></button>
    </div>

    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-gas-pump"></i> Fuel Records</h2>
        </div>

        <!-- Filter Section -->
        <div class="filter-card">
            <form method="get" action="/Admin/FuelRecords">
                <div class="filter-form">
                    <div class="filter-group">
                        <label><i class="fas fa-calendar"></i> From Date</label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate">
                    </div>
                    <div class="filter-group">
                        <label><i class="fas fa-calendar"></i> To Date</label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate">
                    </div>
                    <div class="filter-group">
                        <label><i class="fas fa-car"></i> Vehicle</label>
                        <select name="vehicleId">
                            <option value="">All Vehicles</option>
                            @if (ViewBag.Vehicles != null)
                            {
                                foreach (var v in ViewBag.Vehicles)
                                {
                                    <option value="@v.VehicleId">@v.RegistrationNumber - @v.Model</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="filter-group">
                        <button type="submit" class="btn-filter"><i class="fas fa-search"></i> Filter</button>
                        <a href="/Admin/FuelRecords" class="btn-reset"><i class="fas fa-undo"></i> Reset</a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-gas-pump"></i>
                <h3>@(ViewBag.TotalLiters?.ToString("N0") ?? "0") L</h3>
                <p>Total Fuel</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-money-bill-wave"></i>
                <h3>KES @(ViewBag.TotalCost?.ToString("N0") ?? "0")</h3>
                <p>Total Cost</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-chart-line"></i>
                <h3>@Model.Count</h3>
                <p>Total Records</p>
            </div>
        </div>

        <!-- Fuel Records Table -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Liters</th>
                        <th>Cost (KES)</th>
                        <th>Mileage</th>
                        <th>Receipt</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td>@record.DateIssued.ToString("MMM dd, yyyy")</td>
                            <td>@(record.Vehicle?.RegistrationNumber ?? "N/A")</td>
                            <td>@record.DriverId</td>
                            <td>@record.FuelLiters L</td>
                            <td>KES @record.FuelCost.ToString("N0")</td>
                            <td>@record.CurrentMileage km</td>
                            <td>@(record.ReceiptNumber ?? "N/A")</td>
                            <td>
                                <button class="btn-view" onclick="viewFuelRecord(@record.FuelRecordId)">
                                    <i class="fas fa-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align:center;">No fuel records found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- View Fuel Record Modal -->
    <div id="fuelModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-gas-pump"></i> Fuel Record Details</h3>
                <button class="close-modal" onclick="closeFuelModal()">✕</button>
            </div>
            <div class="modal-body" id="fuelModalBody"></div>
        </div>
    </div>

    <script>
            function openSidebar() {
                document.getElementById('mobileSidebar').classList.add('open');
                document.getElementById('overlay').classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                document.getElementById('mobileSidebar').classList.remove('open');
                document.getElementById('overlay').classList.remove('show');
                document.body.style.overflow = '';
            }

            async function viewFuelRecord(id) {
                const response = await fetch(`/Admin/GetFuelRecord/${id}`);
                const record = await response.json();
                const html = `
                    <div class="detail-row"><strong>Record ID:</strong> ${record.fuelRecordId}</div>
                    <div class="detail-row"><strong>Date:</strong> ${record.dateIssued}</div>
                    <div class="detail-row"><strong>Vehicle:</strong> ${record.vehicleReg} (${record.vehicleModel})</div>
                    <div class="detail-row"><strong>Driver:</strong> ${record.driverName}</div>
                    <div class="detail-row"><strong>Fuel Liters:</strong> ${record.fuelLiters} L</div>
                    <div class="detail-row"><strong>Fuel Cost:</strong> KES ${record.fuelCost}</div>
                    <div class="detail-row"><strong>Cost per Liter:</strong> KES ${record.costPerLiter}</div>
                    <div class="detail-row"><strong>Current Mileage:</strong> ${record.currentMileage} km</div>
                    <div class="detail-row"><strong>Receipt Number:</strong> ${record.receiptNumber || 'N/A'}</div>
                    <div class="detail-row"><strong>Issued By:</strong> ${record.issuedByName}</div>
                    <div class="detail-row"><strong>Notes:</strong> ${record.notes || 'No notes'}</div>
                `;
                document.getElementById('fuelModalBody').innerHTML = html;
                document.getElementById('fuelModal').classList.add('show');
            }

            function closeFuelModal() {
                document.getElementById('fuelModal').classList.remove('show');
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeFuelModal();
                    closeSidebar();
                }
            });
    </script>
</body>
</html>