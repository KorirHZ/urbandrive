@{
    ViewData["Title"] = "Vehicle Management - UrbanDrive";
    Layout = null;
}

@model List<UrbanDrive.Models.Vehicle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>UrbanDrive Executive - Vehicle Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f0eb;
                display: flex;
                min-height: 100vh;
                overflow-x: hidden;
            }

            :root {
                --sidebar-width: 250px;
                --gold: #DAA520;
                --dark: #1a1a2e;
                --white: #ffffff;
                --success: #27ae60;
                --danger: #e74c3c;
                --warning: #f39c12;
                --info: #3498db;
            }

            /* ==================== SIDEBAR ==================== */
            .sidebar {
                width: var(--sidebar-width);
                background: var(--dark);
                color: white;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                display: flex;
                flex-direction: column;
                transition: left 0.3s ease;
                z-index: 1000;
                overflow-x: hidden;
            }

            .sidebar-brand {
                padding: 20px;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

                .sidebar-brand h1 {
                    color: var(--gold);
                    font-size: 22px;
                    letter-spacing: 2px;
                }

                .sidebar-brand p {
                    color: rgba(255,255,255,0.5);
                    font-size: 10px;
                    letter-spacing: 3px;
                }

            .sidebar-divider {
                height: 1px;
                background: rgba(255,255,255,0.05);
                margin: 10px 20px;
            }

            .sidebar-nav {
                flex: 1;
                padding: 10px 0;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 12px 25px;
                color: rgba(255,255,255,0.7);
                text-decoration: none;
                transition: all 0.3s;
                font-size: 14px;
                border-left: 3px solid transparent;
            }

                .sidebar-link:hover {
                    background: rgba(255,255,255,0.05);
                    color: white;
                }

                .sidebar-link.active {
                    background: rgba(218, 165, 32, 0.1);
                    color: var(--gold);
                    border-left-color: var(--gold);
                }

                .sidebar-link i {
                    width: 20px;
                    font-size: 16px;
                }

            .sidebar-footer {
                padding: 15px 20px;
                border-top: 1px solid rgba(255,255,255,0.05);
            }

            .sidebar-user {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,0.7);
                font-size: 14px;
                margin-top: 10px;
            }

                .sidebar-user i {
                    font-size: 28px;
                    color: var(--gold);
                }

            /* Mobile Toggle */
            .sidebar-toggle {
                display: none;
                position: fixed;
                top: 15px;
                left: 15px;
                z-index: 1100;
                background: var(--dark);
                color: var(--gold);
                border: none;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 20px;
                cursor: pointer;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 999;
            }

                .sidebar-overlay.show {
                    display: block;
                }

            /* ==================== MAIN CONTENT ==================== */
            .main-content {
                margin-left: var(--sidebar-width);
                flex: 1;
                padding: 25px 30px;
                transition: margin-left 0.3s ease;
                min-height: 100vh;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px;
            }

                .page-header h2 {
                    font-size: 28px;
                    color: var(--dark);
                    border-left: 4px solid var(--gold);
                    padding-left: 15px;
                }

                .page-header p {
                    color: #666;
                    font-size: 14px;
                    margin-top: 5px;
                    padding-left: 19px;
                }

            .btn-add {
                background: var(--gold);
                color: var(--dark);
                border: none;
                padding: 10px 22px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: bold;
                text-decoration: none;
                display: inline-block;
                transition: all 0.3s;
            }

                .btn-add:hover {
                    background: #e6b800;
                    transform: translateY(-1px);
                }

            .alert {
                padding: 12px 15px;
                border-radius: 8px;
                margin-bottom: 15px;
                font-size: 14px;
            }

            .alert-success {
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
            }

            .alert-danger {
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
            }

            /* ==================== STATS CARDS ==================== */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
                margin-bottom: 30px;
            }

            .stat-card {
                border-radius: 15px;
                padding: 22px 25px;
                color: white;
                position: relative;
                overflow: hidden;
                transition: transform 0.3s;
                cursor: default;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            }

                .stat-card:hover {
                    transform: translateY(-5px);
                }

                .stat-card .stat-icon {
                    position: absolute;
                    right: 15px;
                    top: 15px;
                    font-size: 40px;
                    opacity: 0.2;
                }

                .stat-card .stat-label {
                    font-size: 13px;
                    opacity: 0.8;
                    margin-bottom: 5px;
                    font-weight: 500;
                }

                .stat-card .stat-number {
                    font-size: 32px;
                    font-weight: bold;
                }

                .stat-card .stat-change {
                    font-size: 12px;
                    margin-top: 8px;
                    opacity: 0.9;
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }

            .stat-change.positive {
                color: #a8e6cf;
            }

            .stat-change.negative {
                color: #ff6b6b;
            }

            .card-blue {
                background: linear-gradient(135deg, #2193b0, #6dd5ed);
            }

            .card-green {
                background: linear-gradient(135deg, #11998e, #38ef7d);
            }

            .card-orange {
                background: linear-gradient(135deg, #f12711, #f5af19);
            }

            .card-purple {
                background: linear-gradient(135deg, #8E2DE2, #4A00E0);
            }

            /* ==================== TABLE ==================== */
            .table-container {
                background: var(--white);
                border-radius: 12px;
                overflow-x: auto;
                box-shadow: 0 2px 15px rgba(0,0,0,0.06);
                margin-bottom: 30px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 800px;
            }

            th {
                background: var(--dark);
                color: white;
                padding: 14px 15px;
                text-align: left;
                font-size: 13px;
                font-weight: 600;
            }

            td {
                padding: 12px 15px;
                border-bottom: 1px solid #f0ece8;
                font-size: 13px;
                color: #333;
            }

            tr:hover td {
                background: #faf7f4;
            }

            .status-badge {
                display: inline-block;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: bold;
            }

            .status-available {
                background: var(--success);
                color: white;
            }

            .status-inuse {
                background: var(--warning);
                color: white;
            }

            .status-repair {
                background: var(--danger);
                color: white;
            }

            .btn-sm {
                padding: 5px 12px;
                border-radius: 5px;
                border: none;
                cursor: pointer;
                font-size: 11px;
                font-weight: bold;
                transition: all 0.3s;
                text-decoration: none;
                display: inline-block;
            }

            .btn-edit {
                background: var(--info);
                color: white;
            }

            .btn-delete {
                background: var(--danger);
                color: white;
            }

            .btn-view {
                background: var(--gold);
                color: var(--dark);
            }

            .btn-sm:hover {
                transform: translateY(-1px);
                opacity: 0.85;
            }

            /* ==================== MODAL ==================== */
            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

                .modal.show {
                    display: flex;
                }

            .modal-content {
                background: white;
                border-radius: 12px;
                max-width: 500px;
                width: 90%;
                max-height: 85vh;
                overflow-y: auto;
            }

            .modal-header {
                background: var(--dark);
                padding: 15px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                border-radius: 12px 12px 0 0;
            }

                .modal-header h3 {
                    color: var(--gold);
                    font-size: 18px;
                }

                .modal-header .close-modal {
                    background: none;
                    border: none;
                    color: white;
                    font-size: 24px;
                    cursor: pointer;
                }

            .modal-body {
                padding: 20px;
            }

            .detail-row {
                margin-bottom: 12px;
                padding-bottom: 8px;
                border-bottom: 1px solid #f0ece8;
            }

                .detail-row strong {
                    color: var(--gold);
                    display: inline-block;
                    width: 140px;
                }

            /* ==================== MOBILE RESPONSIVE ==================== */
            /* Tablets and smaller laptops */
            @@media (max-width: 1024px) {
                .stats-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            /* Mobile phones and tablets */
            @@media (max-width: 768px) {
                .sidebar-toggle {
                    display: block;
                }

                .sidebar {
                    left: -280px;
                    width: 280px;
                }

                    .sidebar.open {
                        left: 0;
                    }

                .main-content {
                    margin-left: 0;
                    padding: 70px 15px 20px;
                }

                .page-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }

                    .page-header h2 {
                        font-size: 22px;
                    }
                /* 🔴 CARDS STACK TO ONE COLUMN ON MOBILE 🔴 */
                .stats-grid {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }

                .stat-card {
                    padding: 18px 20px;
                }

                    .stat-card .stat-number {
                        font-size: 24px;
                    }

                    .stat-card .stat-icon {
                        font-size: 30px;
                    }

                .sidebar-overlay.show {
                    display: block;
                }
            }

            /* Small mobile phones */
            @@media (max-width: 480px) {
                .stats-grid {
                    grid-template-columns: 1fr;
                    gap: 10px;
                }

                .stat-card {
                    padding: 15px 18px;
                }

                    .stat-card .stat-number {
                        font-size: 20px;
                    }

                    .stat-card .stat-label {
                        font-size: 12px;
                    }

                .page-header h2 {
                    font-size: 18px;
                }

                .btn-add {
                    width: 100%;
                    text-align: center;
                }

                .table-container {
                    border-radius: 8px;
                }

                th,
                td {
                    padding: 8px 10px;
                    font-size: 11px;
                }

                .btn-sm {
                    font-size: 10px;
                    padding: 4px 8px;
                    margin: 2px;
                }
            }
    </style>
</head>
<body>

    <!-- Mobile Toggle -->
    <button class="sidebar-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- ==================== SIDEBAR ==================== -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1>URBANDRIVE</h1>
            <p>EXECUTIVE</p>
        </div>

        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav">
            <a href="/Admin/Dashboard" class="sidebar-link">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="/Admin/Vehicles" class="sidebar-link active">
                <i class="fas fa-car"></i>
                <span>Vehicles</span>
            </a>
            <a href="/Admin/Drivers" class="sidebar-link">
                <i class="fas fa-users"></i>
                <span>Drivers</span>
            </a>
            <a href="/Admin/Users/Index" class="sidebar-link">
                <i class="fas fa-user-friends"></i>
                <span>Users</span>
            </a>
            <a href="/Admin/Bookings" class="sidebar-link">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </a>
            <a href="/Admin/FuelRecords" class="sidebar-link">
                <i class="fas fa-gas-pump"></i>
                <span>Fuel Records</span>
            </a>
            <a href="/Admin/FuelPriceSettings" class="sidebar-link">
                <i class="fas fa-sliders-h"></i>
                <span>Fuel Price</span>
            </a>
            <a href="/Admin/TripReports" class="sidebar-link">
                <i class="fas fa-file-alt"></i>
                <span>Trip Reports</span>
            </a>
        </nav>

        <div class="sidebar-divider"></div>

        <div class="sidebar-footer">
            <a href="/Admin/Logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
            <div class="sidebar-user">
                <i class="fas fa-user-circle"></i>
                <span>@User.Identity?.Name ?? "Admin"</span>
            </div>
        </div>
    </div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="page-header">
            <div>
                <h2><i class="fas fa-car" style="color: var(--gold); margin-right: 10px;"></i> Vehicle Management</h2>
                <p>Manage your fleet, track vehicle status and maintenance</p>
            </div>
            <a href="/Admin/CreateVehicle" class="btn-add">
                <i class="fas fa-plus"></i> Add New Vehicle
            </a>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card card-blue">
                <i class="fas fa-car stat-icon"></i>
                <div class="stat-label">Total Vehicles</div>
                <div class="stat-number">@Model.Count</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> Fleet size
                </div>
            </div>

            <div class="stat-card card-green">
                <i class="fas fa-check-circle stat-icon"></i>
                <div class="stat-label">Available</div>
                <div class="stat-number">@Model.Count(v => v.Status == "Available")</div>
                <div class="stat-change positive">
                    <i class="fas fa-check"></i> Ready for use
                </div>
            </div>

            <div class="stat-card card-orange">
                <i class="fas fa-car stat-icon"></i>
                <div class="stat-label">In Use</div>
                <div class="stat-number">@Model.Count(v => v.Status == "InUse")</div>
                <div class="stat-change negative">
                    <i class="fas fa-clock"></i> Currently assigned
                </div>
            </div>

            <div class="stat-card card-purple">
                <i class="fas fa-tools stat-icon"></i>
                <div class="stat-label">In Repair</div>
                <div class="stat-number">@Model.Count(v => v.Status == "InRepair")</div>
                <div class="stat-change negative">
                    <i class="fas fa-tools"></i> Under maintenance
                </div>
            </div>
        </div>

        <!-- Vehicles Table -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Registration</th>
                        <th>Model</th>
                        <th>Capacity</th>
                        <th>Mileage</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehicle in Model)
                    {
                        <tr>
                            <td><strong>@vehicle.VehicleId</strong></td>
                            <td>@vehicle.RegistrationNumber</td>
                            <td>@vehicle.Model</td>
                            <td>@vehicle.Capacity</td>
                            <td>@vehicle.CurrentMileage km</td>
                            <td>
                                @if (vehicle.Status == "Available")
                                {
                                    <span class="status-badge status-available"><i class="fas fa-check-circle"></i> Available</span>
                                }
                                else if (vehicle.Status == "InUse")
                                {
                                    <span class="status-badge status-inuse"><i class="fas fa-car"></i> In Use</span>
                                }
                                else
                                {
                                    <span class="status-badge status-repair"><i class="fas fa-tools"></i> In Repair</span>
                                }
                            </td>
                            <td>
                                <a href="/Admin/EditVehicle/@vehicle.VehicleId" class="btn-sm btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="/Admin/DeleteVehicle/@vehicle.VehicleId" class="btn-sm btn-delete">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                                <button class="btn-sm btn-view" onclick="viewDetails(@vehicle.VehicleId)">
                                    <i class="fas fa-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding: 30px; color: #999;">
                                <i class="fas fa-car" style="font-size: 24px; display: block; margin-bottom: 10px; color: var(--gold);"></i>
                                No vehicles found. Add your first vehicle to get started.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Details Modal -->
    <div id="detailsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-info-circle"></i> Vehicle Details</h3>
                <button class="close-modal" onclick="closeDetailsModal()">✕</button>
            </div>
            <div class="modal-body" id="detailsBody"></div>
        </div>
    </div>

    <script>
            // ==================== SIDEBAR ====================
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('open');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            document.querySelectorAll('.sidebar-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth <= 768) {
                        document.getElementById('sidebar').classList.remove('open');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });

            // ==================== VIEW DETAILS ====================
            async function viewDetails(id) {
                try {
                    const response = await fetch(`/Admin/GetVehicleDetails/${id}`);
                    const v = await response.json();

                    if (v.success !== false) {
                        const html = `
                            <div class="detail-row"><strong>Vehicle ID:</strong> ${v.vehicleId}</div>
                            <div class="detail-row"><strong>Registration:</strong> ${v.registrationNumber}</div>
                            <div class="detail-row"><strong>Model:</strong> ${v.model}</div>
                            <div class="detail-row"><strong>Capacity:</strong> ${v.capacity} seats</div>
                            <div class="detail-row"><strong>Status:</strong> ${v.status}</div>
                            <div class="detail-row"><strong>Current Mileage:</strong> ${v.currentMileage} km</div>
                            <div class="detail-row"><strong>Fuel Type:</strong> ${v.fuelType || 'Not specified'}</div>
                            <div class="detail-row"><strong>Last Service:</strong> ${v.lastServiceDate || 'Not recorded'}</div>
                            <div class="detail-row"><strong>Next Service Due:</strong> ${v.nextServiceDue || 'Not scheduled'}</div>
                            <div class="detail-row"><strong>Notes:</strong> ${v.notes || 'No notes'}</div>
                            <div class="detail-row"><strong>Created:</strong> ${v.createdAt}</div>
                        `;
                        document.getElementById('detailsBody').innerHTML = html;
                        document.getElementById('detailsModal').classList.add('show');
                    } else {
                        alert('Failed to load vehicle details');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred while loading vehicle details');
                }
            }

            function closeDetailsModal() {
                document.getElementById('detailsModal').classList.remove('show');
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeDetailsModal();
                }
            });
    </script>

</body>
</html>